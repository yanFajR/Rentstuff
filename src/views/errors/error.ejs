<%
  const titles = {
    400: 'Permintaan Tidak Valid',
    403: 'Akses Ditolak',
    404: 'Halaman Tidak Ditemukan',
    429: 'Terlalu Banyak Permintaan',
    500: 'Terjadi Gangguan Sistem',
  };
  const title = titles[statusCode] || 'Terjadi Kesalahan';
  locals.pageTitle = `${title} (${statusCode})`;

  const statusIcons = {
    400: 'alert',
    403: 'lock',
    404: 'search',
    429: 'clock',
    500: 'alert',
  };
  const icon = statusIcons[statusCode] || 'alert';
%>
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="flex min-h-screen items-center justify-center bg-slate-50 px-4 py-12 text-slate-900">
  <main class="w-full max-w-lg rounded-3xl border border-slate-200/90 bg-white p-8 text-center shadow-sm" aria-labelledby="error-title">
    <div class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-rose-50 text-rose-600 border border-rose-100">
      <%- include('../partials/icon', { iconName: icon, iconClass: 'h-8 w-8' }) %>
    </div>

    <span class="mt-5 inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">
      KODE KESALAHAN <%= statusCode %>
    </span>
    <h1 id="error-title" class="mt-2 text-2xl font-bold tracking-tight text-slate-900"><%= title %></h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-600"><%= message %></p>
    
    <% if (hint) { %>
      <p class="mt-2 text-xs text-slate-500 bg-slate-50 rounded-xl p-3 border border-slate-100"><%= hint %></p>
    <% } %>

    <% if (details && details.length > 0) { %>
      <ul class="mx-auto mt-4 max-w-md space-y-1.5 text-left text-xs text-rose-700">
        <% details.forEach(function (detail) { %>
          <li class="rounded-xl border border-rose-100 bg-rose-50/70 px-3.5 py-2.5 font-medium"><%= detail %></li>
        <% }); %>
      </ul>
    <% } %>

    <div class="mt-8 flex flex-col gap-2.5 sm:flex-row sm:justify-center">
      <a href="/dashboard" class="btn btn-primary justify-center">
        <%- include('../partials/icon', { iconName: 'dashboard', iconClass: 'h-4 w-4' }) %>
        Kembali ke ringkasan
      </a>
      <% if (!locals.currentUser) { %>
        <a href="/login" class="btn btn-secondary justify-center">
          Halaman masuk
        </a>
      <% } %>
    </div>

    <p class="mt-8 border-t border-slate-100 pt-4 text-xs text-slate-400">
      &copy; <%= locals.currentYear || '2026' %> <%= locals.appName %> · Butuh bantuan? Hubungi tim dukungan operasional kami.
    </p>
  </main>
</body>
</html>
