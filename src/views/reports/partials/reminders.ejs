<%
  const listQuery = {
    tab: 'reminders',
    period: period.period,
    from: period.from,
    to: period.to,
    q: filters.q,
    type: filters.type,
  };
  const exportQuery = {
    period: period.period,
    from: period.from,
    to: period.to,
    q: filters.q,
    type: filters.type,
  };
%>
<section class="space-y-4">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h3 class="text-base font-bold text-slate-900">Laporan efektivitas pengingat</h3>
      <p class="mt-0.5 text-xs text-slate-500">Periode acuan berdasarkan jadwal pengingat. Rekam jejak interaksi tercatat akurat dalam Waktu Indonesia Barat (WIB).</p>
    </div>
    <a href="<%= buildUrl('/reports/export/reminders', exportQuery) %>" class="btn btn-secondary">
      <%- include('../../partials/icon', { iconName: 'download', iconClass: 'h-4 w-4 text-slate-500' }) %>
      Unduh CSV
    </a>
  </header>

  <!-- Metric Funnel Tiles -->
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-6">
    <div class="card p-4">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Dibuat</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-slate-900"><%= formatNumber(report.summary.createdCount) %></p>
    </div>
    <div class="card p-4 border-brand-100 bg-brand-50/30">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-brand-800">Siap Dihubungi</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-brand-900"><%= formatNumber(report.summary.readyCount) %></p>
    </div>
    <div class="card p-4">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Menunggu Jadwal</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-slate-700"><%= formatNumber(report.summary.pendingCount) %></p>
    </div>
    <div class="card p-4 bg-slate-50/50">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Dilewati</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-slate-500"><%= formatNumber(report.summary.skippedCount) %></p>
    </div>
    <div class="card p-4 border-sky-100 bg-sky-50/40">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-sky-800">WhatsApp Dibuka</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-sky-900"><%= formatNumber(report.summary.openedCount) %></p>
    </div>
    <div class="card p-4 border-emerald-100 bg-emerald-50/40">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-800">Ditandai Terkirim</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-emerald-900"><%= formatNumber(report.summary.sentCount) %></p>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <form
    method="get"
    action="/reports"
    class="flex flex-col gap-3 card p-4 sm:flex-row sm:items-center"
    hx-get="/reports"
    hx-target="#report-content"
    hx-select="#report-content"
    hx-swap="outerHTML"
    hx-push-url="true"
    hx-trigger="submit, keyup changed delay:400ms from:find input[name='q'], change from:find select[name='type']"
  >
    <input type="hidden" name="tab" value="reminders" />
    <input type="hidden" name="period" value="<%= period.period %>" />
    <input type="hidden" name="from" value="<%= period.from %>" />
    <input type="hidden" name="to" value="<%= period.to %>" />
    
    <div class="relative flex-1">
      <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
        <%- include('../../partials/icon', { iconName: 'search', iconClass: 'h-4 w-4' }) %>
      </span>
      <input
        name="q"
        type="search"
        aria-label="Cari data"
        value="<%= filters.q %>"
        placeholder="Cari nomor tagihan atau nama pelanggan..."
        class="input-field pl-10"
      />
    </div>

    <div class="sm:w-64">
      <select name="type" aria-label="Filter jenis" class="select-field">
        <option value="">Semua jenis pengingat</option>
        <% reminderRules.forEach(function (rule) { %>
          <option value="<%= rule.type %>" <%= filters.type === rule.type ? 'selected' : '' %>><%= rule.label %></option>
        <% }); %>
      </select>
    </div>

    <button type="submit" class="btn btn-secondary shrink-0">
      <%- include('../../partials/icon', { iconName: 'filter', iconClass: 'h-4 w-4' }) %>
      Terapkan
    </button>
  </form>

  <div class="card overflow-hidden">
    <header class="flex items-center justify-between gap-3 border-b border-slate-100 bg-slate-50/50 px-5 py-3.5">
      <div>
        <h4 class="text-sm font-bold text-slate-900">Riwayat &amp; Antrean Pengingat</h4>
        <p class="text-xs text-slate-500"><%= formatNumber(report.pagination.total) %> pengingat ditemukan</p>
      </div>
      <span class="text-[11px] font-medium text-slate-500">Tanggal acuan: Tanggal jadwal</span>
    </header>

    <% if (report.rows.length === 0) { %>
      <div class="px-5 py-16 text-center">
        <span class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
          <%- include('../../partials/icon', { iconName: 'bell', iconClass: 'h-6 w-6' }) %>
        </span>
        <p class="mt-3 text-sm font-bold text-slate-900">Tidak ada pengingat pada filter ini</p>
        <p class="mx-auto mt-1 max-w-sm text-xs text-slate-500">Coba ubah periode atau jenis aturan pengingat.</p>
      </div>
    <% } else { %>
      <div class="table-shell">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
          <thead>
            <tr class="bg-slate-50/70 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
              <th scope="col" class="px-5 py-3.5">Tanggal</th>
              <th scope="col" class="px-4 py-3.5">Tagihan</th>
              <th scope="col" class="hidden px-4 py-3.5 md:table-cell">Pelanggan</th>
              <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Jenis</th>
              <th scope="col" class="px-4 py-3.5">Status Antrean</th>
              <th scope="col" class="px-4 py-3.5">Aktivitas Kontak</th>
              <th scope="col" class="hidden px-4 py-3.5 lg:table-cell">Dibuka</th>
              <th scope="col" class="hidden px-4 py-3.5 lg:table-cell">Terkirim</th>
              <th scope="col" class="hidden px-4 py-3.5 xl:table-cell">Operator</th>
              <th scope="col" class="hidden px-5 py-3.5 sm:table-cell"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% report.rows.forEach(function (row) { %>
              <tr class="transition hover:bg-slate-50/70">
                <td class="whitespace-nowrap px-5 py-3.5 text-xs text-slate-600"><%= formatDate(row.scheduledDate) %></td>
                <td class="whitespace-nowrap px-4 py-3.5">
                  <a href="/reminders/<%= row.id %>" class="font-bold text-slate-900 transition hover:text-brand-600"><%= row.invoiceNumber %></a>
                  <p class="mt-0.5 text-xs text-slate-500 md:hidden"><%= row.customerName %></p>
                </td>
                <td class="hidden px-4 py-3.5 font-medium text-slate-800 md:table-cell"><%= row.customerName %></td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 sm:table-cell">
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-700">
                    <%= reminderTypeLabels[row.reminderType] || row.reminderType %>
                  </span>
                </td>
                <td class="px-4 py-3.5">
                  <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-[11px] font-semibold <%= reminderJobStatusClasses[row.status] %>">
                    <%= reminderJobStatusLabels[row.status] %>
                  </span>
                </td>
                <td class="px-4 py-3.5">
                  <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-[11px] font-semibold <%= reminderContactStatusClasses[row.contactStatus] %>">
                    <%= row.contactStatus === 'SENT' ? 'Ditandai terkirim' : reminderContactStatusLabels[row.contactStatus] %>
                  </span>
                </td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-500 lg:table-cell">
                  <%= row.openedAt ? formatDateTime(row.openedAt) : '—' %>
                </td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-500 lg:table-cell">
                  <%= row.sentAt ? formatDateTime(row.sentAt) : '—' %>
                </td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-600 xl:table-cell"><%= row.activityUser %></td>
                <td class="hidden px-5 py-3.5 text-right sm:table-cell">
                  <a href="/reminders/<%= row.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 transition hover:text-brand-700">
                    Detail <%- include('../../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="table-scroll-hint sm:hidden">Geser tabel ke samping untuk melihat jejak pengiriman WhatsApp.</p>
    <% } %>

    <%- include('../../partials/pagination', { pagination: report.pagination, path: '/reports', query: listQuery }) %>
  </div>

  <div class="rounded-2xl border border-slate-200/90 bg-slate-50 px-4 py-3 text-xs leading-relaxed text-slate-500">
    “Ditandai terkirim” adalah pencatatan konfirmasi manual oleh staf/pemilik rental bahwa pesan WhatsApp telah diselesaikan. Bukan bukti otomatis bahwa nomor penerima telah menerima atau membaca pesan.
  </div>
</section>
