<%
  const listQuery = {
    tab: 'invoices',
    period: period.period,
    from: period.from,
    to: period.to,
    q: filters.q,
    status: filters.status,
    dueFrom: filters.dueFrom,
    dueTo: filters.dueTo,
    sort: filters.sort,
  };
  const exportQuery = {
    period: period.period,
    from: period.from,
    to: period.to,
    q: filters.q,
    status: filters.status,
    dueFrom: filters.dueFrom,
    dueTo: filters.dueTo,
    sort: filters.sort,
  };
  const sortLabels = {
    issue_desc: 'Tanggal terbit terbaru',
    issue_asc: 'Tanggal terbit terlama',
    due_asc: 'Jatuh tempo terdekat',
    due_desc: 'Jatuh tempo terjauh',
    total_desc: 'Total terbesar',
  };
  const unpaidCount = report.summary.unpaidCount + report.summary.partialCount + report.summary.overdueCount;
%>
<section class="space-y-4">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h3 class="text-base font-bold text-slate-900">Laporan tagihan</h3>
      <p class="mt-0.5 text-xs text-slate-500">Periode acuan berdasarkan tanggal penerbitan tagihan. Status dihitung secara dinamis saat laporan dibuat.</p>
    </div>
    <a href="<%= buildUrl('/reports/export/invoices', exportQuery) %>" class="btn btn-secondary">
      <%- include('../../partials/icon', { iconName: 'download', iconClass: 'h-4 w-4 text-slate-500' }) %>
      Unduh CSV
    </a>
  </header>

  <!-- Metric Quick Tiles -->
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
    <div class="card p-4">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Tagihan Diterbitkan</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-slate-900"><%= formatRupiah(report.summary.totalIssued) %></p>
    </div>
    <div class="card p-4 border-emerald-100 bg-emerald-50/30">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-800">Lunas</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-emerald-700"><%= formatNumber(report.summary.paidCount) %></p>
    </div>
    <div class="card p-4 border-amber-100 bg-amber-50/30">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-800">Belum Lunas</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-amber-700"><%= formatNumber(unpaidCount) %></p>
    </div>
    <div class="card p-4 border-rose-100 bg-rose-50/30">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-rose-800">Terlambat</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-rose-700"><%= formatNumber(report.summary.overdueCount) %></p>
    </div>
    <div class="card p-4 bg-slate-50/50">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Dibatalkan</p>
      <p class="mt-1.5 text-xl font-bold tracking-tight text-slate-500"><%= formatNumber(report.summary.cancelledCount) %></p>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <form
    method="get"
    action="/reports"
    class="grid gap-3 card p-4 sm:grid-cols-2 lg:grid-cols-12 lg:items-end"
    hx-get="/reports"
    hx-target="#report-content"
    hx-select="#report-content"
    hx-swap="outerHTML"
    hx-push-url="true"
    hx-trigger="submit, keyup changed delay:400ms from:find input[name='q'], change from:find select[name='status'], change from:find input[name='dueFrom'], change from:find input[name='dueTo'], change from:find select[name='sort']"
  >
    <input type="hidden" name="tab" value="invoices" />
    <input type="hidden" name="period" value="<%= period.period %>" />
    <input type="hidden" name="from" value="<%= period.from %>" />
    <input type="hidden" name="to" value="<%= period.to %>" />
    
    <div class="relative lg:col-span-3">
      <label for="q" class="field-label">Pencarian</label>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
          <%- include('../../partials/icon', { iconName: 'search', iconClass: 'h-4 w-4' }) %>
        </span>
        <input
          id="q"
          name="q"
          type="search"
          aria-label="Cari data"
          value="<%= filters.q %>"
          placeholder="Tagihan, pelanggan..."
          class="input-field pl-10"
        />
      </div>
    </div>

    <div class="lg:col-span-2">
      <label for="status" class="field-label">Status tagihan</label>
      <select id="status" name="status" aria-label="Filter status" class="select-field">
        <option value="">Semua status</option>
        <option value="UNPAID" <%= filters.status === 'UNPAID' ? 'selected' : '' %>>Belum dibayar</option>
        <option value="PARTIAL" <%= filters.status === 'PARTIAL' ? 'selected' : '' %>>Dibayar sebagian</option>
        <option value="PAID" <%= filters.status === 'PAID' ? 'selected' : '' %>>Lunas</option>
        <option value="OVERDUE" <%= filters.status === 'OVERDUE' ? 'selected' : '' %>>Terlambat</option>
        <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>Dibatalkan</option>
      </select>
    </div>

    <div class="lg:col-span-2">
      <label for="dueFrom" class="field-label">Jatuh tempo dari</label>
      <input id="dueFrom" name="dueFrom" type="date" value="<%= filters.dueFrom %>" class="input-field" />
    </div>

    <div class="lg:col-span-2">
      <label for="dueTo" class="field-label">Jatuh tempo sampai</label>
      <input id="dueTo" name="dueTo" type="date" value="<%= filters.dueTo %>" class="input-field" />
    </div>

    <div class="lg:col-span-2">
      <label for="sort" class="field-label">Urutan</label>
      <select id="sort" name="sort" aria-label="Urutkan" class="select-field">
        <% Object.keys(sortLabels).forEach(function (key) { %>
          <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>><%= sortLabels[key] %></option>
        <% }); %>
      </select>
    </div>

    <div class="flex items-center justify-end lg:col-span-1">
      <button type="submit" class="btn btn-secondary w-full" aria-label="Terapkan filter">
        <%- include('../../partials/icon', { iconName: 'filter', iconClass: 'h-4 w-4' }) %>
      </button>
    </div>
  </form>

  <div class="card overflow-hidden">
    <header class="flex items-center justify-between gap-3 border-b border-slate-100 bg-slate-50/50 px-5 py-3.5">
      <div>
        <h4 class="text-sm font-bold text-slate-900">Data Tagihan &amp; Piutang</h4>
        <p class="text-xs text-slate-500"><%= formatNumber(report.pagination.total) %> tagihan ditemukan</p>
      </div>
      <span class="text-[11px] font-medium text-slate-500">Tanggal acuan: Tanggal terbit</span>
    </header>

    <% if (report.rows.length === 0) { %>
      <div class="px-5 py-16 text-center">
        <span class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
          <%- include('../../partials/icon', { iconName: 'invoice', iconClass: 'h-6 w-6' }) %>
        </span>
        <p class="mt-3 text-sm font-bold text-slate-900">Tidak ada tagihan pada filter ini</p>
        <p class="mx-auto mt-1 max-w-sm text-xs text-slate-500">Coba ubah filter periode atau parameter jatuh tempo.</p>
      </div>
    <% } else { %>
      <div class="table-shell">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
          <thead>
            <tr class="bg-slate-50/70 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
              <th scope="col" class="px-5 py-3.5">Tagihan</th>
              <th scope="col" class="px-4 py-3.5">Pelanggan</th>
              <th scope="col" class="hidden px-4 py-3.5 2xl:table-cell">Penyewaan</th>
              <th scope="col" class="hidden px-4 py-3.5 2xl:table-cell">Terbit</th>
              <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Jatuh Tempo</th>
              <th scope="col" class="hidden px-4 py-3.5 text-right lg:table-cell">Total</th>
              <th scope="col" class="hidden px-4 py-3.5 text-right xl:table-cell">Dibayar</th>
              <th scope="col" class="px-4 py-3.5 text-right">Sisa</th>
              <th scope="col" class="px-4 py-3.5">Status</th>
              <th scope="col" class="hidden px-5 py-3.5 sm:table-cell"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% report.rows.forEach(function (row) { %>
              <tr class="transition hover:bg-slate-50/70">
                <td class="whitespace-nowrap px-5 py-3.5">
                  <a href="/invoices/<%= row.id %>" class="font-bold text-slate-900 transition hover:text-brand-600"><%= row.invoiceNumber %></a>
                  <p class="mt-0.5 text-xs text-slate-500 sm:hidden"><%= row.customerName %></p>
                </td>
                <td class="px-4 py-3.5 font-medium text-slate-800"><%= row.customerName %></td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 text-slate-500 2xl:table-cell"><%= row.rentalNumber %></td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 text-slate-500 2xl:table-cell"><%= formatDate(row.issueDate) %></td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-600 sm:table-cell"><%= formatDate(row.dueDate) %></td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 text-right font-medium text-slate-800 lg:table-cell"><%= formatRupiah(row.totalAmount) %></td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 text-right font-medium text-emerald-700 xl:table-cell"><%= formatRupiah(row.totalPaid) %></td>
                <td class="whitespace-nowrap px-4 py-3.5 text-right font-bold <%= row.outstanding > 0 ? 'text-amber-700' : 'text-emerald-700' %>">
                  <%= formatRupiah(row.outstanding) %>
                </td>
                <td class="px-4 py-3.5">
                  <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-[11px] font-semibold <%= invoiceStatusClasses[row.status] %>">
                    <%= invoiceStatusLabels[row.status] %>
                  </span>
                </td>
                <td class="hidden px-5 py-3.5 text-right sm:table-cell">
                  <a href="/invoices/<%= row.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 transition hover:text-brand-700">
                    Detail <%- include('../../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="table-scroll-hint sm:hidden">Geser tabel ke samping untuk melihat jatuh tempo dan status.</p>
    <% } %>

    <%- include('../../partials/pagination', { pagination: report.pagination, path: '/reports', query: listQuery }) %>
  </div>

  <div class="rounded-2xl border border-slate-200/90 bg-slate-50 px-4 py-3 text-xs leading-relaxed text-slate-500">
    Ringkasan mengikuti seluruh tagihan pada periode terpilih, bukan hanya filter status aktif. Tagihan dibatalkan tetap tercatat secara audit dan dihitung terpisah; nilai tagihan aktif tidak memasukkannya.
  </div>
</section>
