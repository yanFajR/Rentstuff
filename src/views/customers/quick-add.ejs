<div class="fixed inset-0 z-50 flex items-end justify-center p-0 sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-labelledby="quick-add-title">
  <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-xs" data-modal-close></div>
  <div class="relative w-full max-w-lg rounded-t-2xl border border-slate-200 bg-white shadow-xl sm:rounded-2xl overflow-hidden">
    <header class="flex items-start justify-between gap-3 border-b border-slate-100 bg-slate-50/50 px-5 py-4">
      <div>
        <h3 id="quick-add-title" class="text-sm font-bold tracking-tight text-slate-900">Tambah Pelanggan Baru</h3>
        <p class="text-xs text-slate-500">Pelanggan baru akan otomatis dipilih pada formulir penyewaan.</p>
      </div>
      <button type="button" data-modal-close class="rounded-lg p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="Tutup modal">
        <%- include('../partials/icon', { iconName: 'close', iconClass: 'h-5 w-5' }) %>
      </button>
    </header>

    <div id="quick-customer-form" class="px-5 py-5">
      <%- include('quick-add-form') %>
    </div>
  </div>
</div>
