<%
  const sortLabels = {
    created_desc: 'Terbaru Ditambahkan',
    created_asc: 'Terlama Ditambahkan',
    name_asc: 'Nama (A–Z)',
    name_desc: 'Nama (Z–A)',
  };
  const listQuery = { q: filters.q, sort: filters.sort };
%>
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-900">Daftar Pelanggan</h2>
            <p class="mt-0.5 text-xs sm:text-sm text-slate-500">Kelola buku kontak pelanggan, status sewa, dan kontak WhatsApp.</p>
          </div>
          <a
            href="/customers/new"
            class="btn btn-primary self-start sm:self-auto shadow-xs"
          >
            <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-4 w-4' }) %>
            Tambah Pelanggan Baru
          </a>
        </div>

        <!-- Filter & Search Toolbar -->
        <form
          method="get"
          action="/customers"
          class="card p-4 flex flex-col gap-3 sm:flex-row sm:items-center"
          hx-get="/customers"
          hx-target="#customer-list"
          hx-select="#customer-list"
          hx-swap="outerHTML"
          hx-push-url="true"
          hx-trigger="submit, keyup changed delay:400ms from:find input[name='q'], change from:find select[name='sort']"
        >
          <div class="relative flex-1">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <%- include('../partials/icon', { iconName: 'search', iconClass: 'h-4 w-4' }) %>
            </span>
            <input
              id="q"
              name="q"
              type="search"
              aria-label="Cari pelanggan"
              value="<%= filters.q %>"
              placeholder="Cari nama pelanggan atau nomor WhatsApp..."
              class="block w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <label class="flex items-center gap-2 text-xs font-semibold text-slate-600 shrink-0">
            <span>Urutkan:</span>
            <select
              name="sort"
              aria-label="Urutkan"
              class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            >
              <% Object.keys(sortLabels).forEach(function (key) { %>
                <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>><%= sortLabels[key] %></option>
              <% }); %>
            </select>
          </label>

          <button
            type="submit"
            class="btn btn-secondary btn-sm"
          >
            Cari
          </button>
        </form>

        <!-- Customer Directory Card -->
        <div id="customer-list" class="card overflow-hidden">
          <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Buku Kontak Pelanggan</h3>
              <p class="text-xs text-slate-500"><%= formatNumber(pagination.total) %> pelanggan terdaftar</p>
            </div>
            <% if (filters.q) { %>
              <a href="<%= buildUrl('/customers', { sort: filters.sort }) %>" class="text-xs font-semibold text-brand-600 transition hover:text-brand-700">Hapus filter pencarian</a>
            <% } %>
          </header>

          <% if (customers.length === 0) { %>
            <div class="px-5 py-14 text-center">
              <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                <%- include('../partials/icon', { iconName: 'users', iconClass: 'h-6 w-6' }) %>
              </div>
              <p class="mt-3 text-sm font-bold text-slate-900">
                <%= filters.q ? 'Pelanggan tidak ditemukan' : 'Belum ada data pelanggan' %>
              </p>
              <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                <%= filters.q ? 'Coba periksa kembali ejaan nama atau nomor WhatsApp yang Anda cari.' : 'Tambahkan pelanggan pertama Anda untuk mulai mencatat transaksi penyewaan.' %>
              </p>
              <% if (!filters.q) { %>
                <a href="/customers/new" class="mt-4 btn btn-primary btn-sm">
                  <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-3.5 w-3.5' }) %>
                  Tambah Pelanggan Baru
                </a>
              <% } %>
            </div>
          <% } else { %>
            <div class="table-shell">
              <table class="min-w-full divide-y divide-slate-100 text-sm">
                <thead>
                  <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                    <th scope="col" class="px-5 py-3.5">Pelanggan</th>
                    <th scope="col" class="px-4 py-3.5">No. WhatsApp</th>
                    <th scope="col" class="hidden px-4 py-3.5 lg:table-cell">Alamat</th>
                    <th scope="col" class="px-4 py-3.5 text-center">Penyewaan</th>
                    <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Terdaftar</th>
                    <th scope="col" class="px-4 py-3.5">Status</th>
                    <th scope="col" class="px-5 py-3.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% customers.forEach(function (customer) { %>
                    <tr class="transition hover:bg-slate-50/60">
                      <td class="px-5 py-3.5">
                        <div class="flex items-center gap-3">
                          <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-slate-100 text-xs font-bold text-slate-700">
                            <%= customer.name.slice(0, 2).toUpperCase() %>
                          </div>
                          <div class="min-w-0">
                            <a href="/customers/<%= customer.id %>" class="block font-semibold text-slate-900 hover:text-brand-600"><%= customer.name %></a>
                            <% if (customer.email) { %>
                              <p class="truncate text-xs text-slate-400"><%= customer.email %></p>
                            <% } %>
                          </div>
                        </div>
                      </td>
                      <td class="whitespace-nowrap px-4 py-3.5 text-slate-700">
                        <span class="inline-flex items-center gap-1.5 font-medium text-slate-800">
                          <%- include('../partials/icon', { iconName: 'phone', iconClass: 'h-3.5 w-3.5 text-emerald-600' }) %>
                          <%= customer.whatsappNumber %>
                        </span>
                      </td>
                      <td class="hidden max-w-[14rem] px-4 py-3.5 lg:table-cell">
                        <span class="line-clamp-1 text-xs text-slate-500"><%= customer.address || '—' %></span>
                      </td>
                      <td class="px-4 py-3.5 text-center font-bold text-slate-800 tabular-nums">
                        <%= formatNumber(customer._count.rentals) %>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-500 sm:table-cell"><%= formatDate(customer.createdAt) %></td>
                      <td class="px-4 py-3.5">
                        <% if (customer.archivedAt) { %>
                          <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-500 border border-slate-200/60">Diarsipkan</span>
                        <% } else { %>
                          <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 border border-emerald-200/60">Aktif</span>
                        <% } %>
                      </td>
                      <td class="px-5 py-3.5 text-right whitespace-nowrap">
                        <a href="/customers/<%= customer.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700">
                          Detail
                          <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <%- include('../partials/pagination', { pagination: pagination, path: '/customers', query: listQuery }) %>
          <% } %>
        </div>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
