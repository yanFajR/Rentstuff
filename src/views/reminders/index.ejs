<%
  const sortLabels = {
    scheduled_desc: 'Jadwal Kirim Terbaru',
    scheduled_asc: 'Jadwal Kirim Terlama',
    created_desc: 'Paling Baru Dibuat',
    due_asc: 'Jatuh Tempo Terdekat',
  };
  const statusOptions = [
    { value: '', label: 'Semua Status' },
    { value: 'PENDING', label: 'Menunggu Jadwal' },
    { value: 'READY', label: 'Siap Dihubungi' },
    { value: 'SKIPPED', label: 'Dilewati' },
  ];
  const listQuery = {
    q: filters.q,
    type: filters.type,
    status: filters.status,
    from: filters.from,
    to: filters.to,
    sort: filters.sort,
  };
  const summaryTiles = [
    { key: 'upcoming', label: 'Akan Jatuh Tempo', value: summary.upcoming, icon: 'calendar', tone: 'bg-slate-100 text-slate-700 border-slate-200/80' },
    { key: 'dueToday', label: 'Jatuh Tempo Hari Ini', value: summary.dueToday, icon: 'clock', tone: 'bg-brand-50 text-brand-700 border-brand-200/80' },
    { key: 'overdue', label: 'Terlambat (Overdue)', value: summary.overdue, icon: 'alert', tone: 'bg-rose-50 text-rose-700 border-rose-200/80' },
    { key: 'notContacted', label: 'Belum Dihubungi', value: summary.notContacted, icon: 'message', tone: 'bg-amber-50 text-amber-700 border-amber-200/80' },
    { key: 'sent', label: 'Ditandai Terkirim', value: summary.sent, icon: 'check', tone: 'bg-emerald-50 text-emerald-700 border-emerald-200/80' },
  ];
%>
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col gap-1">
          <h2 class="text-xl font-bold tracking-tight text-slate-900">Pusat Pengingat Pembayaran (WhatsApp)</h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Sistem otomatis menyiapkan jadwal pengingat tagihan belum lunas setiap hari pukul 09.00 WIB untuk H-3, H-1, Hari H, dan H+1.
          </p>
        </div>

        <!-- Summary Metric Tiles -->
        <section aria-label="Ringkasan pengingat" class="grid grid-cols-2 gap-3 lg:grid-cols-5">
          <% summaryTiles.forEach(function (tile) { %>
            <article class="card p-4 border <%= tile.tone.split(' ').pop() %> transition hover:border-slate-300">
              <div class="flex items-center justify-between gap-2">
                <p class="truncate text-[11px] font-semibold uppercase tracking-wider text-slate-500"><%= tile.label %></p>
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg <%= tile.tone %>">
                  <%- include('../partials/icon', { iconName: tile.icon, iconClass: 'h-3.5 w-3.5' }) %>
                </span>
              </div>
              <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums"><%= formatNumber(tile.value) %></p>
            </article>
          <% }); %>
        </section>

        <!-- Filter Toolbar -->
        <form
          method="get"
          action="/reminders"
          class="card p-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-12"
          hx-get="/reminders"
          hx-target="#reminder-list"
          hx-select="#reminder-list"
          hx-swap="outerHTML"
          hx-push-url="true"
          hx-trigger="submit, keyup changed delay:400ms from:find input[name='q'], change from:find select[name='type'], change from:find select[name='status'], change from:find input[name='from'], change from:find input[name='to'], change from:find select[name='sort']"
        >
          <div class="relative lg:col-span-4">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <%- include('../partials/icon', { iconName: 'search', iconClass: 'h-4 w-4' }) %>
            </span>
            <input
              id="q"
              name="q"
              type="search"
              aria-label="Cari pengingat"
              value="<%= filters.q %>"
              placeholder="Cari nomor tagihan atau nama penyewa..."
              class="block w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="lg:col-span-2">
            <select
              id="type"
              name="type"
              aria-label="Jenis pengingat"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            >
              <option value="">Semua Jenis Pengingat</option>
              <% reminderRules.forEach(function (rule) { %>
                <option value="<%= rule.type %>" <%= filters.type === rule.type ? 'selected' : '' %>><%= rule.label %></option>
              <% }); %>
            </select>
          </div>

          <div class="lg:col-span-2">
            <select
              id="status"
              name="status"
              aria-label="Status pengingat"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            >
              <% statusOptions.forEach(function (option) { %>
                <option value="<%= option.value %>" <%= filters.status === option.value ? 'selected' : '' %>><%= option.label %></option>
              <% }); %>
            </select>
          </div>

          <div class="lg:col-span-2">
            <input
              id="from"
              name="from"
              type="date"
              aria-label="Dari jadwal"
              title="Dari jadwal"
              value="<%= filters.from %>"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="lg:col-span-2">
            <input
              id="to"
              name="to"
              type="date"
              aria-label="Sampai jadwal"
              title="Sampai jadwal"
              value="<%= filters.to %>"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="flex items-center justify-end gap-3 sm:col-span-2 lg:col-span-12 pt-1 border-t border-slate-100">
            <div class="flex items-center gap-2 mr-auto">
              <label for="sort" class="text-xs font-semibold text-slate-500">Urutkan:</label>
              <select
                id="sort"
                name="sort"
                class="rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
              >
                <% Object.keys(sortLabels).forEach(function (key) { %>
                  <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>><%= sortLabels[key] %></option>
                <% }); %>
              </select>
            </div>
            <a href="/reminders" class="text-xs font-semibold text-slate-500 transition hover:text-slate-800">Reset filter</a>
            <button
              type="submit"
              class="btn btn-secondary btn-sm"
            >
              <%- include('../partials/icon', { iconName: 'filter', iconClass: 'h-3.5 w-3.5' }) %>
              Terapkan Filter
            </button>
          </div>
        </form>

        <!-- Reminder List Card -->
        <div id="reminder-list" class="card overflow-hidden">
          <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Antrean Pengingat Pembayaran</h3>
              <p class="text-xs text-slate-500"><%= formatNumber(pagination.total) %> jadwal pengingat ditemukan</p>
            </div>
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">Zona Waktu: WIB (Asia/Jakarta)</span>
          </header>

          <% if (reminders.length === 0) { %>
            <div class="px-5 py-14 text-center">
              <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                <%- include('../partials/icon', { iconName: 'bell', iconClass: 'h-6 w-6' }) %>
              </div>
              <p class="mt-3 text-sm font-bold text-slate-900">Belum ada antrean pengingat</p>
              <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                Pengingat akan dibuat otomatis oleh sistem untuk faktur tagihan yang belum lunas dan mendekati jatuh tempo.
              </p>
            </div>
          <% } else { %>
            <div class="table-shell">
              <table class="min-w-full divide-y divide-slate-100 text-sm">
                <thead>
                  <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                    <th scope="col" class="px-5 py-3.5">Faktur Tagihan</th>
                    <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Pelanggan</th>
                    <th scope="col" class="hidden px-4 py-3.5 2xl:table-cell">No. WhatsApp</th>
                    <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Jatuh Tempo</th>
                    <th scope="col" class="px-4 py-3.5 text-right">Sisa Piutang</th>
                    <th scope="col" class="hidden px-4 py-3.5 md:table-cell">Jenis & Jadwal</th>
                    <th scope="col" class="px-4 py-3.5">Status Job</th>
                    <th scope="col" class="px-5 py-3.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% reminders.forEach(function (reminder) { %>
                    <tr class="transition hover:bg-slate-50/60">
                      <td class="whitespace-nowrap px-5 py-3.5">
                        <a href="/reminders/<%= reminder.id %>" class="font-semibold text-slate-900 hover:text-brand-600"><%= reminder.invoice.invoiceNumber %></a>
                        <p class="mt-0.5 truncate text-xs text-slate-500 sm:hidden"><%= reminder.invoice.rentalRecord.customer.name %></p>
                        <span class="mt-1 inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold <%= reminderTimingClasses[reminder.timingCategory] %>"><%= reminderTimingLabels[reminder.timingCategory] %></span>
                      </td>
                      <td class="hidden px-4 py-3.5 sm:table-cell">
                        <a href="/customers/<%= reminder.invoice.rentalRecord.customer.id %>" class="block font-medium text-slate-900 hover:text-brand-600"><%= reminder.invoice.rentalRecord.customer.name %></a>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-600 2xl:table-cell"><%= reminder.invoice.rentalRecord.customer.whatsappNumber %></td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-600 sm:table-cell"><%= formatDate(reminder.invoice.dueDate) %></td>
                      <td class="whitespace-nowrap px-4 py-3.5 text-right">
                        <p class="font-bold tabular-nums <%= reminder.summary.outstanding > 0 ? 'text-amber-700' : 'text-emerald-700' %>"><%= formatRupiah(reminder.summary.outstanding) %></p>
                        <p class="mt-0.5 hidden text-[10px] text-slate-400 sm:block">
                          Total <%= formatRupiah(reminder.invoice.totalAmount) %> · Bayar <%= formatRupiah(reminder.summary.totalPaid) %>
                        </p>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 md:table-cell">
                        <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-medium text-slate-700"><%= reminderTypeLabels[reminder.reminderType] || reminder.reminderType %></span>
                        <p class="mt-0.5 text-[11px] text-slate-500">Jadwal: <%= formatDate(reminder.scheduledDate) %></p>
                      </td>
                      <td class="px-4 py-3.5 whitespace-nowrap">
                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= reminderJobStatusClasses[reminder.status] %>"><%= reminderJobStatusLabels[reminder.status] %></span>
                        <div class="mt-1">
                          <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold <%= reminderContactStatusClasses[reminder.contactStatus] %>"><%= reminderContactStatusLabels[reminder.contactStatus] %></span>
                        </div>
                        <% if (reminder.status === 'SKIPPED' && reminder.skipReason) { %>
                          <p class="mt-0.5 max-w-[12rem] text-[10px] text-slate-400 leading-tight"><%= reminder.skipReason %></p>
                        <% } %>
                      </td>
                      <td class="px-5 py-3.5 text-right whitespace-nowrap">
                        <a href="/reminders/<%= reminder.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700">
                          Detail
                          <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <%- include('../partials/pagination', { pagination: pagination, path: '/reminders', query: listQuery }) %>
          <% } %>
        </div>

        <p class="pb-2 text-center text-xs text-slate-500">
          Membuka WhatsApp secara langsung mencatat log aktivitas <span class="font-semibold text-slate-700">WhatsApp dibuka</span>. Status “Terkirim” diubah setelah Anda mengonfirmasi pesan telah dikirim.
        </p>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
