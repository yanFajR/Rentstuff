<%
  const sentActivity = reminder.activities.slice().reverse().find(function (activity) {
    return activity.activityType === 'MARKED_SENT';
  });
  const openedActivity = reminder.activities.slice().reverse().find(function (activity) {
    return activity.activityType === 'WHATSAPP_OPENED';
  });
%>
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <a href="/reminders" class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500 transition hover:text-brand-700">
              <%- include('../partials/icon', { iconName: 'chevronLeft', iconClass: 'h-3.5 w-3.5' }) %>
              Kembali ke daftar pengingat
            </a>
            <div class="mt-2 flex flex-wrap items-center gap-2.5">
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900"><%= reminder.invoice.invoiceNumber %></h2>
              <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700 border border-slate-200/60">
                <%= reminderTypeLabels[reminder.reminderType] || reminder.reminderType %>
              </span>
              <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold <%= reminderJobStatusClasses[reminder.status] %>">
                <%= reminderJobStatusLabels[reminder.status] %>
              </span>
            </div>
            <p class="mt-0.5 text-xs sm:text-sm text-slate-500">
              Penyewa: <span class="font-semibold text-slate-800"><%= reminder.invoice.rentalRecord.customer.name %></span> · Jatuh tempo <%= formatDate(reminder.invoice.dueDate) %>
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <% if (canOpen) { %>
              <form
                method="post"
                action="/reminders/<%= reminder.id %>/whatsapp"
                target="_blank"
                data-submit-loading
                class="inline-flex"
              >
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />
                <button
                  type="submit"
                  class="btn btn-success btn-sm shadow-xs"
                >
                  <%- include('../partials/icon', { iconName: 'message', iconClass: 'h-4 w-4' }) %>
                  Buka & Kirim WhatsApp
                </button>
              </form>
            <% } %>
            <a
              href="#riwayat"
              class="btn btn-secondary btn-sm"
            >
              <%- include('../partials/icon', { iconName: 'clock', iconClass: 'h-3.5 w-3.5' }) %>
              Lihat Riwayat
            </a>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold <%= reminderTimingClasses[reminder.timingCategory] %>">
            <%= reminderTimingLabels[reminder.timingCategory] %>
          </span>
          <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold <%= reminderContactStatusClasses[contactStatus] %>">
            <%= reminderContactStatusLabels[contactStatus] %>
          </span>
          <% if (sentActivity) { %>
            <span class="text-xs text-slate-500">Ditandai terkirim pada <%= formatDateTime(sentActivity.createdAt) %></span>
          <% } else if (openedActivity) { %>
            <span class="text-xs text-slate-500">WhatsApp dibuka pada <%= formatDateTime(openedActivity.createdAt) %></span>
          <% } %>
        </div>

        <% if (reminder.status === 'SKIPPED') { %>
          <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-100 p-4 text-xs sm:text-sm text-slate-700 shadow-2xs">
            <%- include('../partials/icon', { iconName: 'archive', iconClass: 'mt-0.5 h-4 w-4 shrink-0 text-slate-500' }) %>
            <div>
              <p class="font-bold">Pengingat ini berstatus dilewati (Skipped).</p>
              <p class="mt-0.5 text-slate-600"><%= reminder.skipReason || 'Tagihan sudah lunas atau dibatalkan sehingga pengingat tidak perlu dikirim.' %></p>
              <p class="mt-0.5 text-[11px] text-slate-500">Seluruh riwayat aktivitas terdahulu tetap tersimpan aman.</p>
            </div>
          </div>
        <% } else if (reminder.status === 'PENDING') { %>
          <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs sm:text-sm text-slate-700 shadow-2xs">
            <%- include('../partials/icon', { iconName: 'clock', iconClass: 'mt-0.5 h-4 w-4 shrink-0 text-slate-500' }) %>
            <p>Pengingat ini dijadwalkan aktif pada <span class="font-bold text-slate-900"><%= formatDate(reminder.scheduledDate) %></span> pukul 09.00 WIB.</p>
          </div>
        <% } else if (!canOpen) { %>
          <div class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50/80 p-4 text-xs sm:text-sm text-amber-900 shadow-2xs">
            <%- include('../partials/icon', { iconName: 'alert', iconClass: 'mt-0.5 h-4 w-4 shrink-0 text-amber-600' }) %>
            <p>
              <% if (!hasValidNumber) { %>
                Nomor WhatsApp pelanggan belum valid. Perbarui nomor kontak di profil pelanggan sebelum membuka pesan.
              <% } else { %>
                Pesan WhatsApp tidak dapat dibuka karena faktur tagihan telah lunas atau berstatus dibatalkan.
              <% } %>
            </p>
          </div>
        <% } %>

        <div class="grid gap-6 lg:grid-cols-3">
          <!-- Information Card -->
          <section class="card overflow-hidden lg:col-span-2">
            <header class="border-b border-slate-100 px-5 py-4">
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Rincian Pengingat Tagihan</h3>
            </header>
            <dl class="grid gap-x-6 gap-y-5 px-5 py-5 sm:grid-cols-2">
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Faktur Tagihan</dt>
                <dd class="mt-1">
                  <a href="/invoices/<%= reminder.invoice.id %>" class="text-sm font-bold text-brand-600 hover:text-brand-700 underline"><%= reminder.invoice.invoiceNumber %></a>
                </dd>
                <dd class="text-xs text-slate-500">Terbit <%= formatDate(reminder.invoice.issueDate) %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Pelanggan (Penyewa)</dt>
                <dd class="mt-1">
                  <a href="/customers/<%= reminder.invoice.rentalRecord.customer.id %>" class="text-sm font-bold text-slate-900 hover:text-brand-600"><%= reminder.invoice.rentalRecord.customer.name %></a>
                </dd>
                <dd class="text-xs font-semibold text-emerald-600"><%= reminder.invoice.rentalRecord.customer.whatsappNumber %></dd>
              </div>
              <div class="border-t border-slate-100 pt-3">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Transaksi Penyewaan</dt>
                <dd class="mt-1">
                  <a href="/rentals/<%= reminder.invoice.rentalRecord.id %>" class="text-sm font-bold text-slate-900 hover:text-brand-600"><%= reminder.invoice.rentalRecord.rentalNumber %></a>
                </dd>
                <dd class="text-xs text-slate-500"><%= reminder.invoice.rentalRecord.itemName %></dd>
              </div>
              <div class="border-t border-slate-100 pt-3">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Bisnis Rental</dt>
                <dd class="mt-1 text-sm font-bold text-slate-900"><%= reminder.invoice.business.name %></dd>
                <dd class="text-xs text-slate-500"><%= reminder.invoice.business.whatsappNumber || 'Nomor bisnis belum diatur' %></dd>
              </div>
              <div class="border-t border-slate-100 pt-3">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Jenis Jadwal Pengingat</dt>
                <dd class="mt-1 text-sm font-semibold text-slate-800"><%= reminderTypeLabels[reminder.reminderType] || reminder.reminderType %></dd>
                <dd class="text-xs text-slate-500"><%= reminderTypeDescriptions[reminder.reminderType] || '' %></dd>
              </div>
              <div class="border-t border-slate-100 pt-3">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Jadwal Eksekusi</dt>
                <dd class="mt-1 text-sm font-semibold text-slate-800"><%= formatDate(reminder.scheduledDate) %></dd>
                <dd class="text-xs text-slate-500">Status jadwal: <%= reminder.processedAt ? 'Diproses pada ' + formatDateTime(reminder.processedAt) : 'Belum diproses' %></dd>
              </div>
              <div class="border-t border-slate-100 pt-3">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Batas Jatuh Tempo Tagihan</dt>
                <dd class="mt-1 text-sm <%= summary.isOverdue ? 'font-bold text-rose-700' : 'font-semibold text-slate-800' %>"><%= formatDate(reminder.invoice.dueDate) %></dd>
              </div>
              <div class="border-t border-slate-100 pt-3">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Status Antrean Pengingat</dt>
                <dd class="mt-1">
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold <%= reminderJobStatusClasses[reminder.status] %>"><%= reminderJobStatusLabels[reminder.status] %></span>
                </dd>
                <% if (reminder.skippedAt) { %>
                  <dd class="mt-1 text-xs text-slate-500">Dilewati pada <%= formatDateTime(reminder.skippedAt) %></dd>
                <% } %>
              </div>
            </dl>
          </section>

          <!-- Financial Recap Card -->
          <section class="card overflow-hidden p-5 flex flex-col justify-between">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Rekap Piutang Terkini</h3>
              <dl class="mt-4 space-y-3 text-sm">
                <div class="flex items-center justify-between gap-3">
                  <dt class="text-slate-500">Total Nilai Tagihan</dt>
                  <dd class="font-bold tabular-nums text-slate-900"><%= formatRupiah(reminder.invoice.totalAmount) %></dd>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <dt class="text-slate-500">Pembayaran Diterima</dt>
                  <dd class="font-bold tabular-nums text-emerald-700"><%= formatRupiah(summary.totalPaid) %></dd>
                </div>
              </dl>

              <div class="mt-4 rounded-xl border border-slate-200/80 bg-slate-50 p-4 shadow-2xs">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Sisa Tagihan yang Ditagihkan</p>
                <p class="mt-1 text-2xl font-bold tracking-tight tabular-nums <%= summary.outstanding > 0 ? 'text-amber-700' : 'text-emerald-700' %>">
                  <%= formatRupiah(summary.outstanding) %>
                </p>
              </div>

              <div class="mt-4 flex items-center justify-between gap-3 text-xs">
                <span class="text-slate-500">Status Faktur:</span>
                <span class="rounded-full px-2.5 py-0.5 font-semibold <%= invoiceStatusClasses[summary.status] %>"><%= invoiceStatusLabels[summary.status] %></span>
              </div>
            </div>

            <p class="mt-5 border-t border-slate-100 pt-3 text-[11px] leading-relaxed text-slate-400">
              Format nominal yang dicantumkan pada template pesan WhatsApp disesuaikan otomatis dengan sisa tagihan aktual saat tombol dibuka.
            </p>
          </section>
        </div>

        <!-- WhatsApp Message Preview -->
        <% if (messagePreview) { %>
          <section class="card overflow-hidden">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
              <div>
                <h3 class="text-sm font-bold tracking-tight text-slate-900">Pratinjau Pesan WhatsApp</h3>
                <p class="text-xs text-slate-500">Teks pesan ini akan otomatis disiapkan di formulir chat WhatsApp penyewa.</p>
              </div>
              <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200/60">WhatsApp Siap Kirim</span>
            </header>
            <div class="p-5">
              <pre class="whitespace-pre-wrap rounded-xl border border-slate-200/90 bg-slate-50/70 p-4 font-sans text-xs sm:text-sm leading-relaxed text-slate-800 shadow-2xs"><%= messagePreview %></pre>
              <p class="mt-3 text-xs text-slate-500">
                Catatan: Membuka WhatsApp via aplikasi ini mencatat aktivitas log sistem. Untuk menandai bahwa Anda telah selesai menghubungi penyewa, konfirmasikan pada tombol di bawah.
              </p>
            </div>
          </section>
        <% } %>

        <!-- Mark as Sent Card -->
        <% if (canMarkSent) { %>
          <section class="card overflow-hidden p-5">
            <h3 class="text-sm font-bold tracking-tight text-slate-900">Konfirmasi Pengiriman Pesan</h3>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">
              Tekan tombol konfirmasi ini setelah Anda menekan tombol kirim di aplikasi WhatsApp. Status pengingat akan ditandai sebagai “Sudah dikirim”.
            </p>
            <form
              method="post"
              action="/reminders/<%= reminder.id %>/marked-sent"
              class="mt-4 space-y-3"
              data-confirm="Tandai pengingat ini sebagai sudah dikirim ke pelanggan via WhatsApp?"
              data-submit-loading
            >
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />
              <div>
                <label for="notes" class="block text-xs font-semibold text-slate-700">Catatan Tanggapan Pelanggan <span class="text-slate-400 font-normal lowercase">(opsional)</span></label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="2"
                  maxlength="500"
                  class="mt-1.5 block w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
                  placeholder="Contoh: Sudah dibaca penyewa dan berjanji akan transfer pelunasan sore ini."
                ></textarea>
              </div>
              <div class="flex justify-end">
                <button
                  type="submit"
                  class="btn btn-success btn-sm shadow-xs"
                >
                  <%- include('../partials/icon', { iconName: 'check', iconClass: 'h-4 w-4' }) %>
                  Tandai Pengingat Sudah Terkirim
                </button>
              </div>
            </form>
          </section>
        <% } %>

        <!-- Activity Timeline -->
        <section id="riwayat" class="card overflow-hidden">
          <header class="border-b border-slate-100 px-5 py-4">
            <h3 class="text-sm font-bold tracking-tight text-slate-900">Riwayat Log Aktivitas Pengingat</h3>
            <p class="text-xs text-slate-500">Catatan interaksi tersimpan secara permanen untuk kebutuhan audit operasional.</p>
          </header>

          <% if (reminder.activities.length === 0) { %>
            <div class="px-5 py-10 text-center text-xs text-slate-500">Belum ada riwayat aktivitas yang tercatat.</div>
          <% } else { %>
            <ol class="space-y-0 p-5">
              <% reminder.activities.forEach(function (activity, index) { %>
                <li class="relative flex gap-3 pb-6 <%= index === reminder.activities.length - 1 ? 'pb-0' : '' %>">
                  <div class="flex flex-col items-center">
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full <%= reminderActivityClasses[activity.activityType] || 'bg-slate-100 text-slate-500' %>">
                      <%- include('../partials/icon', { iconName: activity.activityType === 'MARKED_SENT' ? 'check' : activity.activityType === 'WHATSAPP_OPENED' ? 'message' : activity.activityType === 'SKIPPED' ? 'archive' : activity.activityType === 'REACTIVATED' ? 'restore' : 'bell', iconClass: 'h-4 w-4' }) %>
                    </span>
                    <% if (index !== reminder.activities.length - 1) { %>
                      <span class="mt-1 w-px flex-1 bg-slate-200" aria-hidden="true"></span>
                    <% } %>
                  </div>
                  <div class="min-w-0 flex-1 pt-0.5">
                    <div class="flex flex-wrap items-center gap-2">
                      <p class="text-xs font-bold text-slate-900"><%= reminderActivityLabels[activity.activityType] || activity.activityType %></p>
                      <span class="text-[11px] text-slate-400"><%= formatDateTime(activity.createdAt) %></span>
                    </div>
                    <p class="mt-0.5 text-xs text-slate-500">
                      Oleh: <span class="font-semibold text-slate-700"><%= activity.user ? activity.user.name : 'Sistem Otomatis' %></span>
                    </p>
                    <% if (activity.notes) { %>
                      <p class="mt-1.5 whitespace-pre-line rounded-lg border border-slate-100 bg-slate-50 p-2.5 text-xs text-slate-700 leading-relaxed"><%= activity.notes %></p>
                    <% } %>
                  </div>
                </li>
              <% }); %>
            </ol>
          <% } %>
        </section>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
