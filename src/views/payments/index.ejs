<%
  const listQuery = { q: filters.q, status: filters.status };
%>
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-900">Riwayat Pembayaran</h2>
            <p class="mt-0.5 text-xs sm:text-sm text-slate-500">Seluruh pencatatan kas masuk dari pelunasan atau cicilan tagihan sewa.</p>
          </div>
          <a
            href="/invoices"
            class="btn btn-secondary self-start sm:self-auto shadow-xs"
          >
            <%- include('../partials/icon', { iconName: 'invoice', iconClass: 'h-4 w-4' }) %>
            Buka Daftar Tagihan
          </a>
        </div>

        <!-- Filter Toolbar -->
        <form
          method="get"
          action="/payments"
          class="card p-4 flex flex-col gap-3 sm:flex-row sm:items-center"
          hx-get="/payments"
          hx-target="#payment-list"
          hx-select="#payment-list"
          hx-swap="outerHTML"
          hx-push-url="true"
          hx-trigger="submit, keyup changed delay:400ms from:find input[name='q'], change from:find select[name='status']"
        >
          <div class="relative flex-1">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <%- include('../partials/icon', { iconName: 'search', iconClass: 'h-4 w-4' }) %>
            </span>
            <input
              id="q"
              name="q"
              type="search"
              aria-label="Cari pembayaran"
              value="<%= filters.q %>"
              placeholder="Cari nomor tagihan, nama pelanggan, atau nomor referensi..."
              class="block w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <label class="flex items-center gap-2 text-xs font-semibold text-slate-600 shrink-0">
            <span>Status:</span>
            <select
              name="status"
              aria-label="Filter status"
              class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            >
              <option value="" <%= filters.status === '' ? 'selected' : '' %>>Semua Status</option>
              <option value="valid" <%= filters.status === 'valid' ? 'selected' : '' %>>Valid (Diterima)</option>
              <option value="void" <%= filters.status === 'void' ? 'selected' : '' %>>Dibatalkan (Void)</option>
            </select>
          </label>

          <button
            type="submit"
            class="btn btn-secondary btn-sm"
          >
            Cari
          </button>
        </form>

        <!-- Payment List Card -->
        <div id="payment-list" class="card overflow-hidden">
          <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Data Transaksi Pembayaran</h3>
              <p class="text-xs text-slate-500"><%= formatNumber(pagination.total) %> transaksi pembayaran ditemukan</p>
            </div>
          </header>

          <% if (payments.length === 0) { %>
            <div class="px-5 py-14 text-center">
              <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                <%- include('../partials/icon', { iconName: 'wallet', iconClass: 'h-6 w-6' }) %>
              </div>
              <p class="mt-3 text-sm font-bold text-slate-900">Belum ada riwayat pembayaran</p>
              <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                Pembayaran dicatat dari faktur tagihan yang telah diterbitkan pada menu Tagihan.
              </p>
              <a href="/invoices" class="mt-4 btn btn-secondary btn-sm">
                Lihat Daftar Tagihan
              </a>
            </div>
          <% } else { %>
            <div class="table-shell">
              <table class="min-w-full divide-y divide-slate-100 text-sm">
                <caption class="sr-only">Daftar pembayaran</caption>
                <thead>
                  <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                    <th scope="col" class="px-5 py-3.5">Tanggal</th>
                    <th scope="col" class="px-4 py-3.5">Faktur Tagihan</th>
                    <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Pelanggan</th>
                    <th scope="col" class="px-4 py-3.5 text-right">Nominal</th>
                    <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Metode</th>
                    <th scope="col" class="hidden px-4 py-3.5 lg:table-cell">Dicatat Oleh</th>
                    <th scope="col" class="px-4 py-3.5">Status</th>
                    <th scope="col" class="px-5 py-3.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% payments.forEach(function (payment) { %>
                    <tr class="transition hover:bg-slate-50/60">
                      <td class="whitespace-nowrap px-5 py-3.5 text-xs font-medium text-slate-600"><%= formatDate(payment.paymentDate) %></td>
                      <td class="whitespace-nowrap px-4 py-3.5">
                        <a href="/invoices/<%= payment.invoice.id %>" class="font-semibold text-slate-900 hover:text-brand-600"><%= payment.invoice.invoiceNumber %></a>
                        <p class="text-xs text-slate-500 sm:hidden mt-0.5"><%= payment.invoice.rentalRecord.customer.name %></p>
                      </td>
                      <td class="hidden px-4 py-3.5 text-slate-800 font-medium sm:table-cell"><%= payment.invoice.rentalRecord.customer.name %></td>
                      <td class="whitespace-nowrap px-4 py-3.5 text-right font-bold tabular-nums <%= payment.voidedAt ? 'text-slate-400 line-through' : 'text-slate-900' %>">
                        <%= formatRupiah(payment.amount) %>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-700 sm:table-cell"><%= paymentMethodLabels[payment.method] || payment.method %></td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-500 lg:table-cell"><%= payment.recordedBy.name %></td>
                      <td class="px-4 py-3.5 whitespace-nowrap">
                        <% if (payment.voidedAt) { %>
                          <span class="inline-flex rounded-full bg-rose-50 px-2.5 py-0.5 text-[11px] font-semibold text-rose-700 border border-rose-200/60">Dibatalkan</span>
                        <% } else { %>
                          <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 border border-emerald-200/60">Valid</span>
                        <% } %>
                      </td>
                      <td class="px-5 py-3.5 text-right whitespace-nowrap">
                        <a href="/payments/<%= payment.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700">
                          Detail
                          <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <%- include('../partials/pagination', { pagination: pagination, path: '/payments', query: listQuery }) %>
          <% } %>
        </div>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
