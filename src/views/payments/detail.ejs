<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div>
          <a href="/payments" class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500 transition hover:text-brand-700">
            <%- include('../partials/icon', { iconName: 'chevronLeft', iconClass: 'h-3.5 w-3.5' }) %>
            Kembali ke riwayat pembayaran
          </a>
          <div class="mt-2 flex flex-wrap items-center gap-2.5">
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900"><%= formatRupiah(payment.amount) %></h2>
            <% if (payment.voidedAt) { %>
              <span class="inline-flex rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700 border border-rose-200/60">Dibatalkan (Void)</span>
            <% } else { %>
              <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200/60">Valid (Diterima)</span>
            <% } %>
          </div>
          <p class="mt-0.5 text-xs sm:text-sm text-slate-500">
            Bukti pembayaran kas masuk untuk faktur
            <a href="/invoices/<%= payment.invoice.id %>" class="font-bold text-brand-600 hover:text-brand-700 underline"><%= payment.invoice.invoiceNumber %></a>
          </p>
        </div>

        <% if (payment.voidedAt) { %>
          <div class="flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50/80 p-4 text-xs sm:text-sm text-rose-800 shadow-2xs">
            <%- include('../partials/icon', { iconName: 'alert', iconClass: 'mt-0.5 h-4 w-4 shrink-0 text-rose-600' }) %>
            <div>
              <p class="font-bold">Pembayaran ini telah dibatalkan (void) pada <%= formatDateTime(payment.voidedAt) %>.</p>
              <p class="mt-0.5">Alasan pembatalan: <%= payment.voidReason || '—' %></p>
              <p class="mt-0.5 text-xs text-rose-700">
                Diproses oleh <%= payment.voidedBy?.name || 'staf' %>. Nominal pembayaran telah otomatis dikeluarkan dari total penerimaan kas.
              </p>
            </div>
          </div>
        <% } %>

        <div class="grid gap-6 lg:grid-cols-3">
          <!-- Information Card -->
          <section class="card overflow-hidden lg:col-span-2">
            <header class="border-b border-slate-100 px-5 py-4">
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Rincian Pembayaran Masuk</h3>
            </header>
            <dl class="grid gap-x-6 gap-y-5 px-5 py-5 sm:grid-cols-2">
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Tanggal Pembayaran</dt>
                <dd class="mt-1 text-sm font-bold text-slate-900"><%= formatDate(payment.paymentDate) %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Metode Pembayaran</dt>
                <dd class="mt-1 text-sm font-semibold text-slate-800"><%= paymentMethodLabels[payment.method] || payment.method %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Nomor Referensi / ID Transaksi</dt>
                <dd class="mt-1 text-sm font-mono text-slate-800"><%= payment.reference || '— Tanpa nomor referensi —' %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Dicatat Oleh</dt>
                <dd class="mt-1 text-sm font-semibold text-slate-800"><%= payment.recordedBy.name %></dd>
                <dd class="text-xs text-slate-400"><%= formatDateTime(payment.createdAt) %></dd>
              </div>
              <div class="sm:col-span-2 border-t border-slate-100 pt-3">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Catatan Khusus</dt>
                <dd class="mt-1 whitespace-pre-line text-sm text-slate-600 leading-relaxed"><%= payment.notes || '— Tidak ada catatan khusus —' %></dd>
              </div>
            </dl>
          </section>

          <!-- Linked Invoice Snapshot Card -->
          <section class="card overflow-hidden p-5 flex flex-col justify-between">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Faktur Tagihan Terkait</h3>
              <div class="mt-3">
                <a href="/invoices/<%= payment.invoice.id %>" class="text-base font-bold text-brand-600 hover:text-brand-700 underline"><%= payment.invoice.invoiceNumber %></a>
                <p class="mt-0.5 text-xs font-semibold text-slate-800"><%= payment.invoice.rentalRecord.customer.name %></p>
                <p class="text-xs text-slate-500"><%= payment.invoice.rentalRecord.rentalNumber %> · <%= payment.invoice.rentalRecord.itemName %></p>
              </div>

              <dl class="mt-4 space-y-2.5 border-t border-slate-100 pt-3 text-xs">
                <div class="flex items-center justify-between gap-3">
                  <dt class="text-slate-500">Total Tagihan:</dt>
                  <dd class="font-bold tabular-nums text-slate-900"><%= formatRupiah(invoice.totalAmount) %></dd>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <dt class="text-slate-500">Total Telah Diterima:</dt>
                  <dd class="font-bold tabular-nums text-emerald-700"><%= formatRupiah(summary.totalPaid) %></dd>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <dt class="text-slate-500">Sisa Piutang:</dt>
                  <dd class="font-bold tabular-nums <%= summary.outstanding > 0 ? 'text-amber-700' : 'text-emerald-700' %>"><%= formatRupiah(summary.outstanding) %></dd>
                </div>
                <div class="flex items-center justify-between gap-3 pt-1">
                  <dt class="text-slate-500">Status Tagihan:</dt>
                  <dd>
                    <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= invoiceStatusClasses[summary.status] %>">
                      <%= invoiceStatusLabels[summary.status] %>
                    </span>
                  </dd>
                </div>
              </dl>
            </div>

            <a href="/invoices/<%= payment.invoice.id %>" class="mt-4 btn btn-secondary btn-sm w-full">
              Buka Faktur Tagihan
            </a>
          </section>
        </div>

        <!-- Void Action Panel -->
        <% if (!payment.voidedAt) { %>
          <section class="card overflow-hidden p-5">
            <h3 class="text-sm font-bold tracking-tight text-slate-900">Batalkan Pembayaran (Void)</h3>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">
              Pembatalan tidak menghapus jejak audit keuangan. Nominal akan otomatis dikeluarkan dari perhitungan pembayaran valid dan sisa piutang tagihan akan dikalkulasi ulang.
            </p>
            <form
              method="post"
              action="/payments/<%= payment.id %>/void"
              class="mt-4 space-y-3"
              data-confirm="Batalkan pembayaran ini? Nominal akan dikeluarkan dari total kas yang diterima."
              data-submit-loading
            >
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />
              <div>
                <label for="voidReason" class="block text-xs font-semibold text-slate-700">Alasan Pembatalan <span class="text-rose-500">*</span></label>
                <textarea
                  id="voidReason"
                  name="reason"
                  rows="2"
                  required
                  maxlength="500"
                  class="input-field"
                  placeholder="Contoh: Kesalahan input nominal atau transaksi transfer bank tertolak/batal."
                ></textarea>
              </div>
              <div class="flex justify-end">
                <button type="submit" class="btn btn-danger btn-sm">
                  <%- include('../partials/icon', { iconName: 'close', iconClass: 'h-4 w-4' }) %>
                  Batalkan Pembayaran Ini
                </button>
              </div>
            </form>
          </section>
        <% } %>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
