<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl space-y-6">
        <div>
          <a href="/invoices/<%= invoice.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500 transition hover:text-brand-700">
            <%- include('../partials/icon', { iconName: 'chevronLeft', iconClass: 'h-3.5 w-3.5' }) %>
            Kembali ke tagihan <%= invoice.invoiceNumber %>
          </a>
          <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-900">Catat Pembayaran Masuk</h2>
          <p class="mt-0.5 text-xs sm:text-sm text-slate-500">Pencatatan kas masuk akan langsung mengurangi sisa piutang dan memperbarui status faktur tagihan.</p>
        </div>

        <!-- Target Invoice Snapshot -->
        <section class="card overflow-hidden p-5 border-brand-200/80 bg-brand-50/30">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Faktur Tagihan</p>
              <p class="mt-1 text-base font-bold text-slate-900"><%= invoice.invoiceNumber %></p>
              <p class="text-xs text-slate-600"><%= invoice.rentalRecord.customer.name %> · <%= invoice.rentalRecord.rentalNumber %></p>
            </div>
            <div class="text-right">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Sisa Piutang Saat Ini</p>
              <p class="mt-1 text-2xl font-bold tracking-tight tabular-nums text-amber-700"><%= formatRupiah(summary.outstanding) %></p>
            </div>
          </div>
          <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-brand-100 pt-3 text-xs">
            <div>
              <dt class="text-slate-500">Total Nilai Faktur:</dt>
              <dd class="mt-0.5 font-bold tabular-nums text-slate-900"><%= formatRupiah(invoice.totalAmount) %></dd>
            </div>
            <div>
              <dt class="text-slate-500">Telah Diterima Sebelumnya:</dt>
              <dd class="mt-0.5 font-bold tabular-nums text-emerald-700"><%= formatRupiah(summary.totalPaid) %></dd>
            </div>
          </dl>
        </section>

        <!-- Payment Input Form -->
        <section class="card overflow-hidden">
          <form method="post" action="/invoices/<%= invoice.id %>/payments" class="divide-y divide-slate-100" data-submit-loading>
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />

            <div class="p-6 space-y-5">
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="amount" class="block text-xs font-semibold text-slate-700">Nominal Pembayaran Diterima (Rp) <span class="text-rose-500">*</span></label>
                  <div class="relative mt-1.5">
                    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm font-semibold text-slate-400">Rp</span>
                    <input
                      id="amount"
                      name="amount"
                      type="text"
                      inputmode="numeric"
                      required
                      value="<%= values.amount %>"
                      aria-invalid="<%= errors.amount ? 'true' : 'false' %>"
                      <%- errors.amount ? 'aria-describedby="amount-error"' : 'aria-describedby="amount-hint"' %>
                      class="block w-full rounded-xl border bg-white py-2.5 pl-11 pr-3.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:outline-hidden focus:ring-2 tabular-nums <%= errors.amount ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
                      placeholder="500000"
                    />
                  </div>
                  <% if (errors.amount) { %>
                    <p id="amount-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.amount %></p>
                  <% } else { %>
                    <p id="amount-hint" class="mt-1.5 text-xs text-slate-400">Batas maksimal pelunasan adalah <%= formatRupiah(summary.outstanding) %>.</p>
                  <% } %>
                </div>

                <div>
                  <label for="paymentDate" class="block text-xs font-semibold text-slate-700">Tanggal Pembayaran <span class="text-rose-500">*</span></label>
                  <input
                    id="paymentDate"
                    name="paymentDate"
                    type="date"
                    required
                    value="<%= values.paymentDate %>"
                    aria-invalid="<%= errors.paymentDate ? 'true' : 'false' %>"
                    <%- errors.paymentDate ? 'aria-describedby="payment-date-error"' : '' %>
                    class="mt-1.5 block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:outline-hidden focus:ring-2 <%= errors.paymentDate ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
                  />
                  <% if (errors.paymentDate) { %>
                    <p id="payment-date-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.paymentDate %></p>
                  <% } %>
                </div>
              </div>

              <div class="grid gap-4 sm:grid-cols-2 pt-2">
                <div>
                  <label for="method" class="block text-xs font-semibold text-slate-700">Metode Pembayaran <span class="text-rose-500">*</span></label>
                  <select
                    id="method"
                    name="method"
                    required
                    aria-invalid="<%= errors.method ? 'true' : 'false' %>"
                    <%- errors.method ? 'aria-describedby="method-error"' : '' %>
                    class="mt-1.5 block w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
                  >
                    <option value="CASH" <%= values.method === 'CASH' ? 'selected' : '' %>>Uang Tunai (Cash)</option>
                    <option value="BANK_TRANSFER" <%= values.method === 'BANK_TRANSFER' ? 'selected' : '' %>>Transfer Bank</option>
                    <option value="E_WALLET" <%= values.method === 'E_WALLET' ? 'selected' : '' %>>Dompet Digital (QRIS / E-Wallet)</option>
                    <option value="OTHER" <%= values.method === 'OTHER' ? 'selected' : '' %>>Metode Lainnya</option>
                  </select>
                  <% if (errors.method) { %>
                    <p id="method-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.method %></p>
                  <% } %>
                </div>

                <div>
                  <label for="reference" class="block text-xs font-semibold text-slate-700">No. Referensi / Bukti Transfer <span class="text-slate-400 font-normal lowercase">(opsional)</span></label>
                  <input
                    id="reference"
                    name="reference"
                    type="text"
                    maxlength="100"
                    value="<%= values.reference %>"
                    aria-invalid="<%= errors.reference ? 'true' : 'false' %>"
                    <%- errors.reference ? 'aria-describedby="reference-error"' : '' %>
                    class="mt-1.5 block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:outline-hidden focus:ring-2 <%= errors.reference ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
                    placeholder="Contoh: BCA 981247 atau ID transaksi QRIS"
                  />
                  <% if (errors.reference) { %>
                    <p id="reference-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.reference %></p>
                  <% } %>
                </div>
              </div>

              <div class="pt-2">
                <label for="notes" class="block text-xs font-semibold text-slate-700">Catatan Penerimaan <span class="text-slate-400 font-normal lowercase">(opsional)</span></label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="2"
                  maxlength="500"
                  aria-invalid="<%= errors.notes ? 'true' : 'false' %>"
                  <%- errors.notes ? 'aria-describedby="payment-notes-error"' : '' %>
                  class="mt-1.5 block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:outline-hidden focus:ring-2 <%= errors.notes ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
                  placeholder="Catatan pelunasan, nama pengirim rekening, dll."
                ><%= values.notes %></textarea>
                <% if (errors.notes) { %>
                  <p id="payment-notes-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.notes %></p>
                <% } %>
              </div>
            </div>

            <div class="flex items-center justify-end gap-3 bg-slate-50/60 px-6 py-4">
              <a href="/invoices/<%= invoice.id %>" class="btn btn-secondary btn-sm">Batal</a>
              <button
                type="submit"
                class="btn btn-primary btn-sm shadow-xs"
              >
                <%- include('../partials/icon', { iconName: 'save', iconClass: 'h-4 w-4' }) %>
                Simpan & Rekonsiliasi Pembayaran
              </button>
            </div>
          </form>
        </section>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
