<%
  const currentMonth = overview.monthlyTrend[overview.monthlyTrend.length - 1];
  const primaryMetrics = overview.metrics.slice(0, 2);
  const secondaryMetrics = overview.metrics.slice(2);
%>
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
  >
    Lewati ke konten utama
  </a>

  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>

  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Operational Briefing Header -->
        <section class="card overflow-hidden border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700 border border-brand-100">
                  <%- include('../partials/icon', { iconName: 'calendar', iconClass: 'h-3.5 w-3.5' }) %>
                  <%= formatDate(overview.generatedAt) %>
                </span>
                <span class="text-xs font-medium text-slate-500">
                  Selamat datang, <span class="font-semibold text-slate-800"><%= locals.currentUser.name %></span>
                </span>
              </div>
              <h2 class="mt-2 text-xl sm:text-2xl font-bold tracking-tight text-slate-900">
                Ringkasan bisnis <%= locals.currentBusiness.name %>
              </h2>
              <p class="mt-1 max-w-2xl text-xs sm:text-sm leading-relaxed text-slate-600">
                Pantau pelanggan, penyewaan aktif, tagihan piutang, dan tindak lanjut pengingat dalam satu tempat.
              </p>
            </div>
            <div class="flex shrink-0 flex-wrap items-center gap-2.5">
              <a
                href="/rentals/new"
                class="btn btn-primary shadow-xs"
              >
                <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-4 w-4' }) %>
                Buat penyewaan
              </a>
              <a
                href="/invoices/new"
                class="btn btn-secondary shadow-xs"
              >
                <%- include('../partials/icon', { iconName: 'invoice', iconClass: 'h-4 w-4' }) %>
                Buat tagihan
              </a>
            </div>
          </div>
        </section>

        <!-- Financial & Operational Metrics -->
        <section aria-label="Ringkasan utama" class="space-y-3">
          <!-- Primary Financial Cards -->
          <div class="grid gap-4 sm:grid-cols-2">
            <% primaryMetrics.forEach(function (metric) { %>
              <article class="card p-5 sm:p-6 border-slate-200/90 transition hover:border-slate-300">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= metric.label %></p>
                    <p class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 tabular-nums">
                      <%= metric.format === 'currency' ? formatRupiah(metric.value) : formatNumber(metric.value) %>
                    </p>
                    <p class="mt-1.5 text-xs text-slate-500"><%= metric.caption %></p>
                  </div>
                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl <%= metric.key === 'receivedAmount' ? 'bg-emerald-50 text-emerald-600' : 'bg-brand-50 text-brand-600' %>">
                    <%- include('../partials/icon', { iconName: metric.icon, iconClass: 'h-6 w-6' }) %>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>

          <!-- Secondary Operational Status Cards -->
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6">
            <% secondaryMetrics.forEach(function (metric) { %>
              <article class="card p-4 border-slate-200/80 transition hover:border-slate-300">
                <div class="flex items-center justify-between gap-2">
                  <p class="truncate text-[11px] font-semibold uppercase tracking-wider text-slate-500"><%= metric.label %></p>
                  <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-slate-50 text-slate-400">
                    <%- include('../partials/icon', { iconName: metric.icon, iconClass: 'h-3.5 w-3.5' }) %>
                  </span>
                </div>
                <p class="mt-2 text-xl font-bold tracking-tight text-slate-900 tabular-nums">
                  <%= metric.format === 'currency' ? formatRupiah(metric.value) : formatNumber(metric.value) %>
                </p>
                <p class="mt-0.5 truncate text-[11px] text-slate-400"><%= metric.caption %></p>
              </article>
            <% }); %>
          </div>
        </section>

        <!-- Kinerja Bulan Berjalan & Trend -->
        <section class="space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Kinerja Bulan Berjalan</h3>
              <p class="text-xs text-slate-500">Performa keuangan dan efektivitas penagihan periode ini.</p>
            </div>
            <a href="/reports" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 transition hover:text-brand-700">
              Laporan bisnis lengkap
              <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
            </a>
          </div>

          <div class="grid gap-3 sm:grid-cols-3">
            <article class="card p-4.5 border-slate-200/90">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700">Pembayaran bulan ini</p>
              <p class="mt-1 text-xl sm:text-2xl font-bold tabular-nums text-emerald-900"><%= formatRupiah(currentMonth.paymentsTotal) %></p>
              <p class="mt-1 text-xs text-slate-500">Total pembayaran valid bulan berjalan</p>
            </article>
            <article class="card p-4.5 border-slate-200/90">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-brand-700">Tagihan diterbitkan bulan ini</p>
              <p class="mt-1 text-xl sm:text-2xl font-bold tabular-nums text-brand-900"><%= formatRupiah(currentMonth.invoiceTotal) %></p>
              <p class="mt-1 text-xs text-slate-500"><%= formatNumber(currentMonth.invoiceCount) %> faktur diterbitkan</p>
            </article>
            <article class="card p-4.5 border-slate-200/90">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-700">Perlu ditindaklanjuti</p>
              <p class="mt-1 text-xl sm:text-2xl font-bold tabular-nums text-amber-900"><%= formatNumber(overview.reminderSummary.notContacted) %></p>
              <p class="mt-1 text-xs text-slate-500">Pengingat siap kirim, belum dihubungi</p>
            </article>
          </div>

          <%- include('../partials/trend-chart', { trend: overview.monthlyTrend }) %>
        </section>

        <!-- Pengingat Pembayaran & WhatsApp Action Center -->
        <section class="card overflow-hidden">
          <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Pengingat Pembayaran WhatsApp</h3>
              <p class="text-xs text-slate-500">Status jadwal pengingat tagihan dan kontak pelanggan terdekat.</p>
            </div>
            <a href="/reminders" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 transition hover:text-brand-700">
              Kelola semua pengingat
              <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
            </a>
          </header>

          <div class="grid grid-cols-2 gap-3 border-b border-slate-100 bg-slate-50/40 p-4 sm:grid-cols-4">
            <div class="rounded-xl border border-amber-200/70 bg-amber-50/70 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-700">Belum dihubungi</p>
              <p class="mt-1 text-xl font-bold tabular-nums text-amber-900"><%= formatNumber(overview.reminderSummary.notContacted) %></p>
            </div>
            <div class="rounded-xl border border-brand-200/70 bg-brand-50/70 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-brand-700">Jatuh tempo hari ini</p>
              <p class="mt-1 text-xl font-bold tabular-nums text-brand-900"><%= formatNumber(overview.reminderSummary.dueToday) %></p>
            </div>
            <div class="rounded-xl border border-rose-200/70 bg-rose-50/70 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-rose-700">Terlambat</p>
              <p class="mt-1 text-xl font-bold tabular-nums text-rose-900"><%= formatNumber(overview.reminderSummary.overdue) %></p>
            </div>
            <div class="rounded-xl border border-emerald-200/70 bg-emerald-50/70 p-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700">Sudah ditandai terkirim</p>
              <p class="mt-1 text-xl font-bold tabular-nums text-emerald-900"><%= formatNumber(overview.reminderSummary.sent) %></p>
            </div>
          </div>

          <% if (overview.recentReminders.length === 0) { %>
            <div class="px-5 py-12 text-center">
              <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                <%- include('../partials/icon', { iconName: 'bell', iconClass: 'h-6 w-6' }) %>
              </div>
              <p class="mt-3 text-sm font-semibold text-slate-900">Belum ada pengingat</p>
              <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                Pengingat dibuat otomatis oleh sistem untuk tagihan yang belum lunas pada H-3, H-1, hari H, dan H+1.
              </p>
              <a href="/reminders" class="mt-4 btn btn-secondary btn-sm">
                Ke halaman pengingat
              </a>
            </div>
          <% } else { %>
            <div class="table-shell">
              <table class="min-w-full divide-y divide-slate-100 text-sm">
                <thead>
                  <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                    <th scope="col" class="px-5 py-3">No. Tagihan</th>
                    <th scope="col" class="hidden px-4 py-3 sm:table-cell">Pelanggan</th>
                    <th scope="col" class="hidden px-4 py-3 md:table-cell">Jadwal Kirim</th>
                    <th scope="col" class="hidden px-4 py-3 lg:table-cell">Jenis</th>
                    <th scope="col" class="px-4 py-3">Status Job</th>
                    <th scope="col" class="hidden px-4 py-3 md:table-cell">Kontak WA</th>
                    <th scope="col" class="px-5 py-3 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% overview.recentReminders.forEach(function (reminder) { %>
                    <tr class="transition hover:bg-slate-50/60">
                      <td class="whitespace-nowrap px-5 py-3.5">
                        <a href="/reminders/<%= reminder.id %>" class="font-semibold text-slate-900 hover:text-brand-600"><%= reminder.invoice.invoiceNumber %></a>
                        <p class="mt-0.5 text-xs text-slate-500 sm:hidden"><%= reminder.invoice.rentalRecord.customer.name %></p>
                      </td>
                      <td class="hidden px-4 py-3.5 text-slate-700 sm:table-cell">
                        <span class="font-medium text-slate-900"><%= reminder.invoice.rentalRecord.customer.name %></span>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-slate-600 md:table-cell"><%= formatDate(reminder.scheduledDate) %></td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 md:table-cell">
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-medium text-slate-700"><%= reminderTypeLabels[reminder.reminderType] || reminder.reminderType %></span>
                      </td>
                      <td class="px-4 py-3.5">
                        <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= reminderJobStatusClasses[reminder.status] %>"><%= reminderJobStatusLabels[reminder.status] %></span>
                      </td>
                      <td class="hidden px-4 py-3.5 md:table-cell">
                        <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= reminderContactStatusClasses[reminder.contactStatus] %>"><%= reminderContactStatusLabels[reminder.contactStatus] %></span>
                      </td>
                      <td class="px-5 py-3.5 text-right">
                        <a href="/reminders/<%= reminder.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700">
                          Detail
                          <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>

        <!-- Tagihan & Pembayaran Terkini (Side-by-Side or Stacked) -->
        <div class="grid gap-6 lg:grid-cols-2">
          <!-- Tagihan Terbaru -->
          <section class="card overflow-hidden">
            <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
              <div>
                <h3 class="text-sm font-bold tracking-tight text-slate-900">Tagihan Terbaru</h3>
                <p class="text-xs text-slate-500">5 tagihan terakhir pada bisnis ini.</p>
              </div>
              <a href="/invoices" class="text-xs font-semibold text-brand-600 hover:text-brand-700">Semua tagihan</a>
            </header>

            <% if (overview.recentInvoices.length === 0) { %>
              <div class="px-5 py-12 text-center">
                <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                  <%- include('../partials/icon', { iconName: 'invoice', iconClass: 'h-6 w-6' }) %>
                </div>
                <p class="mt-3 text-sm font-semibold text-slate-900">Belum ada tagihan</p>
                <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                  Buat tagihan dari penyewaan untuk mulai memantau piutang.
                </p>
                <a href="/invoices/new" class="btn btn-primary btn-sm mt-4">
                  <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-3.5 w-3.5' }) %>
                  Buat tagihan pertama
                </a>
              </div>
            <% } else { %>
              <div class="table-shell">
                <table class="min-w-full divide-y divide-slate-100 text-sm">
                  <caption class="sr-only">Lima tagihan terbaru</caption>
                  <thead>
                    <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                      <th scope="col" class="px-5 py-3">Tagihan</th>
                      <th scope="col" class="px-4 py-3">Pelanggan</th>
                      <th scope="col" class="px-4 py-3 text-right">Total</th>
                      <th scope="col" class="px-4 py-3 text-right">Sisa</th>
                      <th scope="col" class="px-5 py-3">Status</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <% overview.recentInvoices.forEach(function (invoice) { %>
                      <tr class="transition hover:bg-slate-50/60">
                        <td class="whitespace-nowrap px-5 py-3">
                          <a href="/invoices/<%= invoice.id %>" class="font-semibold text-slate-900 hover:text-brand-600"><%= invoice.invoiceNumber %></a>
                          <p class="text-[11px] text-slate-400">Jatuh tempo <%= formatDate(invoice.dueDate) %></p>
                        </td>
                        <td class="px-4 py-3 text-slate-700">
                          <p class="font-medium text-slate-900"><%= invoice.rentalRecord.customer.name %></p>
                        </td>
                        <td class="whitespace-nowrap px-4 py-3 text-right font-medium tabular-nums text-slate-800"><%= formatRupiah(invoice.totalAmount) %></td>
                        <td class="whitespace-nowrap px-4 py-3 text-right font-semibold tabular-nums <%= invoice.summary.outstanding > 0 ? 'text-amber-700' : 'text-emerald-700' %>"><%= formatRupiah(invoice.summary.outstanding) %></td>
                        <td class="px-5 py-3">
                          <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= invoiceStatusClasses[invoice.summary.status] %>">
                            <%= invoiceStatusLabels[invoice.summary.status] %>
                          </span>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </section>

          <!-- Pembayaran Terbaru -->
          <section class="card overflow-hidden">
            <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
              <div>
                <h3 class="text-sm font-bold tracking-tight text-slate-900">Pembayaran Terbaru</h3>
                <p class="text-xs text-slate-500">5 pembayaran terakhir yang tercatat.</p>
              </div>
              <a href="/payments" class="text-xs font-semibold text-brand-600 hover:text-brand-700">Semua pembayaran</a>
            </header>

            <% if (overview.recentPayments.length === 0) { %>
              <div class="px-5 py-12 text-center">
                <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                  <%- include('../partials/icon', { iconName: 'wallet', iconClass: 'h-6 w-6' }) %>
                </div>
                <p class="mt-3 text-sm font-semibold text-slate-900">Belum ada pembayaran</p>
                <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                  Pembayaran dicatat dari faktur tagihan yang telah diterbitkan.
                </p>
                <a href="/invoices" class="btn btn-secondary btn-sm mt-4">
                  Buka daftar tagihan
                </a>
              </div>
            <% } else { %>
              <div class="table-shell">
                <table class="min-w-full divide-y divide-slate-100 text-sm">
                  <caption class="sr-only">Lima pembayaran terbaru</caption>
                  <thead>
                    <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                      <th scope="col" class="px-5 py-3">Tanggal</th>
                      <th scope="col" class="px-4 py-3">Tagihan</th>
                      <th scope="col" class="px-4 py-3 text-right">Nominal</th>
                      <th scope="col" class="hidden px-4 py-3 md:table-cell">Metode</th>
                      <th scope="col" class="px-5 py-3">Status</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <% overview.recentPayments.forEach(function (payment) { %>
                      <tr class="transition hover:bg-slate-50/60">
                        <td class="whitespace-nowrap px-5 py-3 text-xs text-slate-600"><%= formatDate(payment.paymentDate) %></td>
                        <td class="whitespace-nowrap px-4 py-3">
                          <a href="/payments/<%= payment.id %>" class="font-semibold text-slate-900 hover:text-brand-600"><%= payment.invoice.invoiceNumber %></a>
                          <p class="text-[11px] text-slate-500"><%= payment.invoice.rentalRecord.customer.name %></p>
                        </td>
                        <td class="whitespace-nowrap px-4 py-3 text-right font-semibold tabular-nums <%= payment.voidedAt ? 'text-slate-400 line-through' : 'text-slate-900' %>">
                          <%= formatRupiah(payment.amount) %>
                        </td>
                        <td class="hidden whitespace-nowrap px-4 py-3 text-xs text-slate-600 md:table-cell"><%= paymentMethodLabels[payment.method] || payment.method %></td>
                        <td class="px-5 py-3">
                          <% if (payment.voidedAt) { %>
                            <span class="inline-flex rounded-full bg-rose-50 px-2.5 py-0.5 text-[11px] font-semibold text-rose-700 border border-rose-200/60">Dibatalkan</span>
                          <% } else { %>
                            <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 border border-emerald-200/60">Valid</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </section>
        </div>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
