<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <a href="/rentals" class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500 transition hover:text-brand-700">
              <%- include('../partials/icon', { iconName: 'chevronLeft', iconClass: 'h-3.5 w-3.5' }) %>
              Kembali ke daftar penyewaan
            </a>
            <div class="mt-2 flex flex-wrap items-center gap-2.5">
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900"><%= rental.rentalNumber %></h2>
              <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold <%= rentalStatusClasses[rental.status] || 'bg-slate-100 text-slate-500' %>">
                <%= rentalStatusLabels[rental.status] || rental.status %>
              </span>
            </div>
            <p class="mt-0.5 text-xs sm:text-sm text-slate-500">
              <%= rental.itemName %> · Dicatat pada <%= formatDateTime(rental.createdAt) %>
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <% if (rental.status === 'ACTIVE') { %>
              <a
                href="/rentals/<%= rental.id %>/edit"
                class="btn btn-secondary btn-sm"
              >
                <%- include('../partials/icon', { iconName: 'edit', iconClass: 'h-3.5 w-3.5' }) %>
                Edit
              </a>
              <form method="post" action="/rentals/<%= rental.id %>/complete" data-confirm="Tandai penyewaan ini sebagai selesai? Status selesai bersifat final." data-submit-loading>
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />
                <button
                  type="submit"
                  class="btn btn-success btn-sm shadow-xs"
                >
                  <%- include('../partials/icon', { iconName: 'check', iconClass: 'h-3.5 w-3.5' }) %>
                  Tandai Selesai
                </button>
              </form>
              <form method="post" action="/rentals/<%= rental.id %>/cancel" data-confirm="Batalkan penyewaan ini? Pembatalan bersifat final dan tidak dapat diubah kembali." data-submit-loading>
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />
                <button
                  type="submit"
                  class="btn btn-danger btn-sm"
                >
                  <%- include('../partials/icon', { iconName: 'close', iconClass: 'h-3.5 w-3.5' }) %>
                  Batalkan
                </button>
              </form>
            <% } %>
          </div>
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
          <!-- Detail Penyewaan Card -->
          <section class="card overflow-hidden lg:col-span-2">
            <header class="border-b border-slate-100 px-5 py-4">
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Informasi Transaksi Penyewaan</h3>
            </header>
            <dl class="grid gap-x-6 gap-y-5 px-5 py-5 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Unit / Barang Sewa</dt>
                <dd class="mt-1 text-base font-bold text-slate-900"><%= rental.itemName %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Tanggal Mulai</dt>
                <dd class="mt-1 text-sm font-medium text-slate-800"><%= formatDate(rental.startDate) %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Tanggal Selesai (Pengembalian)</dt>
                <dd class="mt-1 text-sm font-medium text-slate-800"><%= formatDate(rental.endDate) %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Tarif Sewa</dt>
                <dd class="mt-1 text-lg font-bold tabular-nums text-slate-900"><%= formatRupiah(rental.price) %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Status Operasional</dt>
                <dd class="mt-1">
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold <%= rentalStatusClasses[rental.status] || 'bg-slate-100 text-slate-500' %>">
                    <%= rentalStatusLabels[rental.status] || rental.status %>
                  </span>
                </dd>
              </div>
              <div class="sm:col-span-2 border-t border-slate-100 pt-3">
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Catatan Khusus</dt>
                <dd class="mt-1 whitespace-pre-line text-sm text-slate-600"><%= rental.notes || '— Tidak ada catatan khusus —' %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Dibuat Pada</dt>
                <dd class="mt-1 text-xs text-slate-500"><%= formatDateTime(rental.createdAt) %></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Terakhir Diperbarui</dt>
                <dd class="mt-1 text-xs text-slate-500"><%= formatDateTime(rental.updatedAt) %></dd>
              </div>
            </dl>
          </section>

          <!-- Customer Sidebar Card -->
          <div class="space-y-6">
            <section class="card overflow-hidden p-5">
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Pelanggan (Penyewa)</h3>
              <div class="mt-3 flex items-center gap-3">
                <div class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-50 text-sm font-bold text-brand-700">
                  <%= rental.customer.name.slice(0, 2).toUpperCase() %>
                </div>
                <div class="min-w-0">
                  <a href="/customers/<%= rental.customer.id %>" class="block truncate text-sm font-semibold text-slate-900 hover:text-brand-600"><%= rental.customer.name %></a>
                  <p class="truncate text-xs font-medium text-emerald-600"><%= rental.customer.whatsappNumber %></p>
                </div>
              </div>
              <dl class="mt-4 space-y-2.5 text-xs border-t border-slate-100 pt-3">
                <div>
                  <dt class="text-slate-400">Email:</dt>
                  <dd class="font-medium text-slate-800"><%= rental.customer.email || '—' %></dd>
                </div>
                <div>
                  <dt class="text-slate-400">Alamat domisili:</dt>
                  <dd class="whitespace-pre-line font-medium text-slate-800"><%= rental.customer.address || '—' %></dd>
                </div>
              </dl>
              <% if (rental.customer.archivedAt) { %>
                <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs font-medium text-amber-800 border border-amber-200/60">
                  Pelanggan ini saat ini berstatus diarsipkan.
                </p>
              <% } %>
            </section>

            <!-- Status Flow Summary -->
            <section class="card p-5">
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Riwayat Status</h3>
              <ol class="mt-3 space-y-3 text-xs">
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600">
                    <%- include('../partials/icon', { iconName: 'check', iconClass: 'h-3.5 w-3.5' }) %>
                  </span>
                  <div>
                    <p class="font-semibold text-slate-800">Transaksi dicatat</p>
                    <p class="text-slate-400"><%= formatDateTime(rental.createdAt) %></p>
                  </div>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full <%= rental.status === 'ACTIVE' ? 'bg-brand-50 text-brand-600' : rental.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>">
                    <%- include('../partials/icon', { iconName: rental.status === 'CANCELLED' ? 'close' : 'check', iconClass: 'h-3.5 w-3.5' }) %>
                  </span>
                  <div>
                    <p class="font-semibold text-slate-800">Status: <%= rentalStatusLabels[rental.status] || rental.status %></p>
                    <p class="text-slate-400">Diperbarui <%= formatDateTime(rental.updatedAt) %></p>
                  </div>
                </li>
              </ol>
            </section>
          </div>

          <!-- Invoices & Payments for this Rental -->
          <section class="card overflow-hidden lg:col-span-3">
            <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
              <div>
                <h3 class="text-sm font-bold tracking-tight text-slate-900">Tagihan & Realisasi Pembayaran</h3>
                <p class="text-xs text-slate-500">Daftar faktur yang diterbitkan khusus untuk transaksi penyewaan ini.</p>
              </div>
              <% if (rental.status !== 'CANCELLED') { %>
                <a href="/invoices/new?rentalRecordId=<%= rental.id %>" class="btn btn-primary btn-sm shadow-xs">
                  <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-3.5 w-3.5' }) %>
                  Terbitkan Tagihan Baru
                </a>
              <% } %>
            </header>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 border-b border-slate-100 bg-slate-50/40 p-4">
              <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 shadow-2xs">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Total Ditagihkan</p>
                <p class="mt-1 text-xl font-bold tabular-nums text-slate-900"><%= formatRupiah(financials.billedAmount) %></p>
              </div>
              <div class="rounded-xl border border-emerald-200/80 bg-white p-3.5 shadow-2xs">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700">Total Dibayar</p>
                <p class="mt-1 text-xl font-bold tabular-nums text-emerald-700"><%= formatRupiah(financials.paidAmount) %></p>
              </div>
              <div class="rounded-xl border border-amber-200/80 bg-white p-3.5 shadow-2xs">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-amber-700">Sisa Piutang</p>
                <p class="mt-1 text-xl font-bold tabular-nums <%= financials.outstandingAmount > 0 ? 'text-amber-700' : 'text-emerald-700' %>"><%= formatRupiah(financials.outstandingAmount) %></p>
              </div>
            </div>

            <% if (invoices.length === 0) { %>
              <div class="px-5 py-12 text-center">
                <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                  <%- include('../partials/icon', { iconName: 'invoice', iconClass: 'h-6 w-6' }) %>
                </div>
                <p class="mt-3 text-sm font-bold text-slate-900">Belum ada tagihan diterbitkan</p>
                <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                  Terbitkan tagihan agar pelanggan mendapatkan rincian pembayaran dan jadwal pengingat WhatsApp.
                </p>
                <% if (rental.status !== 'CANCELLED') { %>
                  <a href="/invoices/new?rentalRecordId=<%= rental.id %>" class="btn btn-primary btn-sm mt-4">
                    <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-3.5 w-3.5' }) %>
                    Terbitkan Tagihan Pertama
                  </a>
                <% } %>
              </div>
            <% } else { %>
              <div class="table-shell">
                <table class="min-w-full divide-y divide-slate-100 text-sm">
                  <thead>
                    <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                      <th scope="col" class="px-5 py-3.5">No. Tagihan</th>
                      <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Jatuh Tempo</th>
                      <th scope="col" class="px-4 py-3.5 text-right">Total</th>
                      <th scope="col" class="hidden px-4 py-3.5 text-right md:table-cell">Dibayar</th>
                      <th scope="col" class="px-4 py-3.5 text-right">Sisa Piutang</th>
                      <th scope="col" class="px-4 py-3.5">Status</th>
                      <th scope="col" class="px-5 py-3.5 text-right">Aksi</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <% invoices.forEach(function (invoice) { %>
                      <tr class="transition hover:bg-slate-50/60">
                        <td class="whitespace-nowrap px-5 py-3.5">
                          <a href="/invoices/<%= invoice.id %>" class="font-semibold text-slate-900 hover:text-brand-600"><%= invoice.invoiceNumber %></a>
                          <p class="text-[11px] text-slate-400">Terbit <%= formatDate(invoice.issueDate) %></p>
                        </td>
                        <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-600 sm:table-cell"><%= formatDate(invoice.dueDate) %></td>
                        <td class="whitespace-nowrap px-4 py-3.5 text-right font-medium tabular-nums text-slate-800"><%= formatRupiah(invoice.totalAmount) %></td>
                        <td class="hidden whitespace-nowrap px-4 py-3.5 text-right font-medium tabular-nums text-emerald-700 md:table-cell"><%= formatRupiah(invoice.summary.totalPaid) %></td>
                        <td class="whitespace-nowrap px-4 py-3.5 text-right font-semibold tabular-nums <%= invoice.summary.outstanding > 0 ? 'text-amber-700' : 'text-emerald-700' %>"><%= formatRupiah(invoice.summary.outstanding) %></td>
                        <td class="px-4 py-3.5 whitespace-nowrap">
                          <span class="inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= invoiceStatusClasses[invoice.summary.status] %>">
                            <%= invoiceStatusLabels[invoice.summary.status] %>
                          </span>
                        </td>
                        <td class="px-5 py-3.5 text-right whitespace-nowrap">
                          <a href="/invoices/<%= invoice.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700">
                            Detail
                            <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </section>
        </div>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
