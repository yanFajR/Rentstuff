<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl space-y-6">
        <div>
          <a href="/rentals/<%= rentalId %>" class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500 transition hover:text-brand-700">
            <%- include('../partials/icon', { iconName: 'chevronLeft', iconClass: 'h-3.5 w-3.5' }) %>
            Kembali ke detail transaksi
          </a>
          <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-900">Ubah Data Penyewaan</h2>
          <p class="mt-0.5 text-xs sm:text-sm text-slate-500">Perubahan informasi hanya dapat diproses selama masa sewa masih berstatus aktif.</p>
        </div>

        <section class="card overflow-hidden">
          <form method="post" action="/rentals/<%= rentalId %>" class="divide-y divide-slate-100" data-submit-loading>
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />
            
            <div class="p-6 space-y-6">
              <% if (invoiceCount > 0) { %>
                <div class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50/80 px-4 py-3 text-xs leading-relaxed text-amber-900 shadow-2xs">
                  <%- include('../partials/icon', { iconName: 'alert', iconClass: 'mt-0.5 h-4 w-4 shrink-0 text-amber-600' }) %>
                  <p>
                    Penyewaan ini telah memiliki <span class="font-bold"><%= invoiceCount %> tagihan</span>.
                    Perubahan harga sewa di sini tidak akan otomatis mengubah nominal faktur yang telah diterbitkan sebelumnya.
                  </p>
                </div>
              <% } %>
              <%- include('partials/form-fields') %>
            </div>

            <div class="flex items-center justify-end gap-3 bg-slate-50/60 px-6 py-4">
              <a href="/rentals/<%= rentalId %>" class="btn btn-secondary btn-sm">Batal</a>
              <button
                type="submit"
                class="btn btn-primary btn-sm shadow-xs"
              >
                <%- include('../partials/icon', { iconName: 'save', iconClass: 'h-4 w-4' }) %>
                Simpan Perubahan
              </button>
            </div>
          </form>
        </section>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
