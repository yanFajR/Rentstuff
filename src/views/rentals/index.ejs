<%
  const sortLabels = {
    created_desc: 'Terbaru Ditambahkan',
    created_asc: 'Terlama Ditambahkan',
    start_desc: 'Tanggal Mulai Terbaru',
    start_asc: 'Tanggal Mulai Terlama',
  };
  const statusOptions = [
    { value: '', label: 'Semua Status Sewa' },
    { value: 'ACTIVE', label: 'Aktif Berjalan' },
    { value: 'COMPLETED', label: 'Selesai' },
    { value: 'CANCELLED', label: 'Dibatalkan' },
  ];
  const listQuery = {
    q: filters.q,
    status: filters.status,
    from: filters.from,
    to: filters.to,
    sort: filters.sort,
  };
%>
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-900">Daftar Penyewaan</h2>
            <p class="mt-0.5 text-xs sm:text-sm text-slate-500">Pantau seluruh catatan unit/barang yang sedang disewa dan status pengembaliannya.</p>
          </div>
          <a
            href="/rentals/new"
            class="btn btn-primary self-start sm:self-auto shadow-xs"
          >
            <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-4 w-4' }) %>
            Catat Penyewaan Baru
          </a>
        </div>

        <!-- Filter Toolbar -->
        <form
          method="get"
          action="/rentals"
          class="card p-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-12"
          hx-get="/rentals"
          hx-target="#rental-list"
          hx-select="#rental-list"
          hx-swap="outerHTML"
          hx-push-url="true"
          hx-trigger="submit, keyup changed delay:400ms from:find input[name='q'], change from:find select[name='status'], change from:find input[name='from'], change from:find input[name='to'], change from:find select[name='sort']"
        >
          <div class="relative lg:col-span-4">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <%- include('../partials/icon', { iconName: 'search', iconClass: 'h-4 w-4' }) %>
            </span>
            <input
              id="q"
              name="q"
              type="search"
              aria-label="Cari penyewaan"
              value="<%= filters.q %>"
              placeholder="Cari nomor transaksi, penyewa, atau barang..."
              class="block w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="lg:col-span-2">
            <select
              name="status"
              aria-label="Filter status"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            >
              <% statusOptions.forEach(function (option) { %>
                <option value="<%= option.value %>" <%= filters.status === option.value ? 'selected' : '' %>><%= option.label %></option>
              <% }); %>
            </select>
          </div>

          <div class="lg:col-span-2">
            <input
              id="from"
              name="from"
              type="date"
              aria-label="Dari tanggal mulai"
              title="Dari tanggal mulai"
              value="<%= filters.from %>"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="lg:col-span-2">
            <input
              id="to"
              name="to"
              type="date"
              aria-label="Sampai tanggal"
              title="Sampai tanggal"
              value="<%= filters.to %>"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="lg:col-span-2">
            <select
              id="sort"
              name="sort"
              aria-label="Urutkan"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            >
              <% Object.keys(sortLabels).forEach(function (key) { %>
                <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>><%= sortLabels[key] %></option>
              <% }); %>
            </select>
          </div>

          <div class="flex items-center justify-end gap-3 sm:col-span-2 lg:col-span-12 pt-1 border-t border-slate-100">
            <a href="/rentals" class="text-xs font-semibold text-slate-500 transition hover:text-slate-800">Reset filter</a>
            <button
              type="submit"
              class="btn btn-secondary btn-sm"
            >
              <%- include('../partials/icon', { iconName: 'filter', iconClass: 'h-3.5 w-3.5' }) %>
              Terapkan Filter
            </button>
          </div>
        </form>

        <!-- Rental List Table -->
        <div id="rental-list" class="card overflow-hidden">
          <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Data Transaksi Penyewaan</h3>
              <p class="text-xs text-slate-500"><%= formatNumber(pagination.total) %> transaksi ditemukan</p>
            </div>
            <a href="/rentals/new" class="text-xs font-semibold text-brand-600 hover:text-brand-700">Tambah penyewaan</a>
          </header>

          <% if (rentals.length === 0) { %>
            <div class="px-5 py-14 text-center">
              <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                <%- include('../partials/icon', { iconName: 'calendar', iconClass: 'h-6 w-6' }) %>
              </div>
              <p class="mt-3 text-sm font-bold text-slate-900">Belum ada data penyewaan</p>
              <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                Buat catatan penyewaan pertama untuk pelanggan Anda. Nomor seri penyewaan dibuat secara otomatis.
              </p>
              <a href="/rentals/new" class="mt-4 btn btn-primary btn-sm">
                <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-3.5 w-3.5' }) %>
                Catat Penyewaan Baru
              </a>
            </div>
          <% } else { %>
            <div class="table-shell">
              <table class="min-w-full divide-y divide-slate-100 text-sm">
                <thead>
                  <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                    <th scope="col" class="px-5 py-3.5">No. Sewa</th>
                    <th scope="col" class="px-4 py-3.5">Penyewa</th>
                    <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Unit / Barang</th>
                    <th scope="col" class="hidden px-4 py-3.5 lg:table-cell">Periode Sewa</th>
                    <th scope="col" class="hidden px-4 py-3.5 text-right md:table-cell">Tarif Sewa</th>
                    <th scope="col" class="px-4 py-3.5">Status</th>
                    <th scope="col" class="px-5 py-3.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% rentals.forEach(function (rental) { %>
                    <tr class="transition hover:bg-slate-50/60">
                      <td class="whitespace-nowrap px-5 py-3.5">
                        <a href="/rentals/<%= rental.id %>" class="font-semibold text-slate-900 hover:text-brand-600"><%= rental.rentalNumber %></a>
                        <p class="text-xs text-slate-500 sm:hidden mt-0.5"><%= rental.itemName %></p>
                      </td>
                      <td class="px-4 py-3.5">
                        <a href="/customers/<%= rental.customer.id %>" class="block font-medium text-slate-900 hover:text-brand-600"><%= rental.customer.name %></a>
                      </td>
                      <td class="hidden max-w-[14rem] px-4 py-3.5 sm:table-cell">
                        <span class="line-clamp-1 text-slate-700 font-medium"><%= rental.itemName %></span>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-600 lg:table-cell">
                        <%= formatDate(rental.startDate) %> – <%= formatDate(rental.endDate) %>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-right font-semibold tabular-nums text-slate-900 md:table-cell"><%= formatRupiah(rental.price) %></td>
                      <td class="px-4 py-3.5 whitespace-nowrap">
                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= rentalStatusClasses[rental.status] || 'bg-slate-100 text-slate-500' %>">
                          <%= rentalStatusLabels[rental.status] || rental.status %>
                        </span>
                      </td>
                      <td class="px-5 py-3.5 text-right whitespace-nowrap">
                        <a href="/rentals/<%= rental.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700">
                          Detail
                          <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <%- include('../partials/pagination', { pagination: pagination, path: '/rentals', query: listQuery }) %>
          <% } %>
        </div>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
