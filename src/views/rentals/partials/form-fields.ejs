<!-- Bagian 1: Informasi Pelanggan -->
<div class="space-y-4">
  <div class="border-b border-slate-100 pb-2">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">1. Data Pelanggan (Penyewa)</h3>
    <p class="text-xs text-slate-500">Pilih pelanggan yang telah terdaftar atau tambahkan pelanggan baru langsung.</p>
  </div>

  <div>
    <div class="flex items-center justify-between gap-2">
      <label for="customerId" class="block text-xs font-semibold text-slate-700">Nama Pelanggan <span class="text-rose-500">*</span></label>
      <a
        href="/customers/new"
        hx-get="/customers/quick-add"
        hx-target="#modal-container"
        hx-swap="innerHTML"
        class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700"
      >
        <%- include('../../partials/icon', { iconName: 'plus', iconClass: 'h-3.5 w-3.5' }) %>
        Tambah Pelanggan Cepat
      </a>
    </div>

    <%- include('../../partials/customer-select', { customers: customers, selectedId: values.customerId, error: errors.customerId }) %>
    <% if (errors.customerId) { %>
      <p id="customer-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.customerId %></p>
    <% } %>
    <% if (customers.length === 0) { %>
      <p class="mt-1.5 text-xs text-amber-700">Belum ada pelanggan aktif. Klik "Tambah Pelanggan Cepat" di atas untuk menambahkan penyewa baru.</p>
    <% } %>
  </div>
</div>

<!-- Bagian 2: Unit / Barang yang Disewa -->
<div class="space-y-4 pt-2">
  <div class="border-b border-slate-100 pb-2">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">2. Unit atau Barang Sewa</h3>
    <p class="text-xs text-slate-500">Ketik jenis kendaraan, perangkat, atau alat yang disewakan.</p>
  </div>

  <div>
    <label for="itemName" class="block text-xs font-semibold text-slate-700">Nama Barang / Unit <span class="text-rose-500">*</span></label>
    <input
      id="itemName"
      name="itemName"
      type="text"
      required
      maxlength="150"
      value="<%= values.itemName %>"
      aria-invalid="<%= errors.itemName ? 'true' : 'false' %>"
      <%- errors.itemName ? 'aria-describedby="item-name-error"' : '' %>
      class="mt-1.5 block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:outline-hidden focus:ring-2 <%= errors.itemName ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
      placeholder="Contoh: Toyota Innova Reborn 2022 / Kamera Sony A7IV"
    />
    <% if (errors.itemName) { %>
      <p id="item-name-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.itemName %></p>
    <% } %>
  </div>
</div>

<!-- Bagian 3: Jadwal & Tarif Sewa -->
<div class="space-y-4 pt-2">
  <div class="border-b border-slate-100 pb-2">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">3. Jadwal & Biaya Sewa</h3>
    <p class="text-xs text-slate-500">Tentukan rentang tanggal peminjaman dan total tarif yang disepakati.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="startDate" class="block text-xs font-semibold text-slate-700">Tanggal Mulai Sewa <span class="text-rose-500">*</span></label>
      <input
        id="startDate"
        name="startDate"
        type="date"
        required
        value="<%= values.startDate %>"
        aria-invalid="<%= errors.startDate ? 'true' : 'false' %>"
        <%- errors.startDate ? 'aria-describedby="start-date-error"' : '' %>
        class="mt-1.5 block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs transition focus:outline-hidden focus:ring-2 <%= errors.startDate ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
      />
      <% if (errors.startDate) { %>
        <p id="start-date-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.startDate %></p>
      <% } %>
    </div>

    <div>
      <label for="endDate" class="block text-xs font-semibold text-slate-700">Tanggal Selesai (Pengembalian) <span class="text-rose-500">*</span></label>
      <input
        id="endDate"
        name="endDate"
        type="date"
        required
        value="<%= values.endDate %>"
        aria-invalid="<%= errors.endDate ? 'true' : 'false' %>"
        <%- errors.endDate ? 'aria-describedby="end-date-error"' : '' %>
        class="mt-1.5 block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs transition focus:outline-hidden focus:ring-2 <%= errors.endDate ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
      />
      <% if (errors.endDate) { %>
        <p id="end-date-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.endDate %></p>
      <% } %>
    </div>
  </div>

  <div>
    <label for="price" class="block text-xs font-semibold text-slate-700">Total Tarif Sewa (Rupiah) <span class="text-rose-500">*</span></label>
    <div class="relative mt-1.5">
      <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm font-semibold text-slate-400">Rp</span>
      <input
        id="price"
        name="price"
        type="text"
        inputmode="numeric"
        required
        value="<%= values.price %>"
        aria-invalid="<%= errors.price ? 'true' : 'false' %>"
        <%- errors.price ? 'aria-describedby="price-error"' : 'aria-describedby="price-hint"' %>
        class="block w-full rounded-xl border bg-white py-2.5 pl-11 pr-3.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:outline-hidden focus:ring-2 tabular-nums <%= errors.price ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
        placeholder="1500000"
      />
    </div>
    <% if (errors.price) { %>
      <p id="price-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.price %></p>
    <% } else { %>
      <p id="price-hint" class="mt-1.5 text-xs text-slate-400">Ketik nominal tanpa simbol mata uang. Titik pemisah ribuan diperbolehkan.</p>
    <% } %>
  </div>
</div>

<!-- Bagian 4: Ketentuan Khusus / Catatan -->
<div class="space-y-4 pt-2">
  <div class="border-b border-slate-100 pb-2">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">4. Catatan Tambahan <span class="text-slate-400 font-normal lowercase">(opsional)</span></h3>
    <p class="text-xs text-slate-500">Tuliskan jaminan KTP/SIM, kelengkapan aksesoris, atau perjanjian khusus.</p>
  </div>

  <div>
    <textarea
      id="notes"
      name="notes"
      rows="3"
      maxlength="1000"
      aria-invalid="<%= errors.notes ? 'true' : 'false' %>"
      <%- errors.notes ? 'aria-describedby="rental-notes-error"' : '' %>
      class="mt-1.5 block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:outline-hidden focus:ring-2 <%= errors.notes ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
      placeholder="Contoh: Jaminan KTP asli ditahan, unit diserahkan dengan bensin penuh."
    ><%= values.notes %></textarea>
    <% if (errors.notes) { %>
      <p id="rental-notes-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= errors.notes %></p>
    <% } %>
  </div>
</div>

<div id="modal-container"></div>
