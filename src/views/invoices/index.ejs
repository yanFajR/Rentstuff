<%
  const sortLabels = {
    created_desc: 'Terbaru Diterbitkan',
    created_asc: 'Terlama Diterbitkan',
    issue_desc: 'Tanggal Terbit Terbaru',
    issue_asc: 'Tanggal Terbit Terlama',
    due_asc: 'Jatuh Tempo Terdekat',
    due_desc: 'Jatuh Tempo Terjauh',
  };
  const statusOptions = [
    { value: '', label: 'Semua Status Tagihan' },
    { value: 'UNPAID', label: 'Belum Dibayar' },
    { value: 'PARTIAL', label: 'Dibayar Sebagian' },
    { value: 'PAID', label: 'Lunas' },
    { value: 'OVERDUE', label: 'Terlambat (Overdue)' },
    { value: 'CANCELLED', label: 'Dibatalkan' },
  ];
  const listQuery = {
    q: filters.q,
    status: filters.status,
    from: filters.from,
    to: filters.to,
    sort: filters.sort,
  };
%>
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<%- include('../partials/head') %>
<body class="min-h-full bg-slate-50 text-slate-900">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Lewati ke konten utama</a>
  <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-xs lg:hidden"></div>
  <%- include('../partials/sidebar') %>

  <div class="flex min-h-screen flex-col lg:pl-72">
    <%- include('../partials/topbar') %>

    <main id="main-content" class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-900">Daftar Tagihan & Faktur</h2>
            <p class="mt-0.5 text-xs sm:text-sm text-slate-500">Pantau seluruh invoice, jadwal jatuh tempo, dan sisa piutang pelanggan.</p>
          </div>
          <a
            href="/invoices/new"
            class="btn btn-primary self-start sm:self-auto shadow-xs"
          >
            <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-4 w-4' }) %>
            Terbitkan Tagihan Baru
          </a>
        </div>

        <!-- Filter Toolbar -->
        <form
          method="get"
          action="/invoices"
          class="card p-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-12"
          hx-get="/invoices"
          hx-target="#invoice-list"
          hx-select="#invoice-list"
          hx-swap="outerHTML"
          hx-push-url="true"
          hx-trigger="submit, keyup changed delay:400ms from:find input[name='q'], change from:find select[name='status'], change from:find input[name='from'], change from:find input[name='to'], change from:find select[name='sort']"
        >
          <div class="relative lg:col-span-4">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <%- include('../partials/icon', { iconName: 'search', iconClass: 'h-4 w-4' }) %>
            </span>
            <input
              id="q"
              name="q"
              type="search"
              aria-label="Cari tagihan"
              value="<%= filters.q %>"
              placeholder="Cari nomor faktur, nama pelanggan, atau sewa..."
              class="block w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="lg:col-span-2">
            <select
              name="status"
              aria-label="Filter status"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            >
              <% statusOptions.forEach(function (option) { %>
                <option value="<%= option.value %>" <%= filters.status === option.value ? 'selected' : '' %>><%= option.label %></option>
              <% }); %>
            </select>
          </div>

          <div class="lg:col-span-2">
            <input
              id="from"
              name="from"
              type="date"
              aria-label="Dari tanggal terbit"
              title="Dari tanggal terbit"
              value="<%= filters.from %>"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="lg:col-span-2">
            <input
              id="to"
              name="to"
              type="date"
              aria-label="Sampai tanggal terbit"
              title="Sampai tanggal terbit"
              value="<%= filters.to %>"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            />
          </div>

          <div class="lg:col-span-2">
            <select
              id="sort"
              name="sort"
              aria-label="Urutkan"
              class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 shadow-2xs focus:border-brand-500 focus:outline-hidden focus:ring-2 focus:ring-brand-500/20"
            >
              <% Object.keys(sortLabels).forEach(function (key) { %>
                <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>><%= sortLabels[key] %></option>
              <% }); %>
            </select>
          </div>

          <div class="flex items-center justify-end gap-3 sm:col-span-2 lg:col-span-12 pt-1 border-t border-slate-100">
            <a href="/invoices" class="text-xs font-semibold text-slate-500 transition hover:text-slate-800">Reset filter</a>
            <button
              type="submit"
              class="btn btn-secondary btn-sm"
            >
              <%- include('../partials/icon', { iconName: 'filter', iconClass: 'h-3.5 w-3.5' }) %>
              Terapkan Filter
            </button>
          </div>
        </form>

        <!-- Invoice List Card -->
        <div id="invoice-list" class="card overflow-hidden">
          <header class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <div>
              <h3 class="text-sm font-bold tracking-tight text-slate-900">Data Tagihan Aktif</h3>
              <p class="text-xs text-slate-500"><%= formatNumber(pagination.total) %> tagihan ditemukan</p>
            </div>
            <a href="/invoices/new" class="text-xs font-semibold text-brand-600 hover:text-brand-700">Buat tagihan</a>
          </header>

          <% if (invoices.length === 0) { %>
            <div class="px-5 py-14 text-center">
              <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-slate-100 text-slate-400">
                <%- include('../partials/icon', { iconName: 'invoice', iconClass: 'h-6 w-6' }) %>
              </div>
              <p class="mt-3 text-sm font-bold text-slate-900">Belum ada tagihan</p>
              <p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-slate-500">
                Buat faktur tagihan dari transaksi penyewaan untuk mulai memantau piutang dan mengaktifkan pengingat WhatsApp.
              </p>
              <a href="/invoices/new" class="mt-4 btn btn-primary btn-sm">
                <%- include('../partials/icon', { iconName: 'plus', iconClass: 'h-3.5 w-3.5' }) %>
                Terbitkan Tagihan Pertama
              </a>
            </div>
          <% } else { %>
            <div class="table-shell">
              <table class="min-w-full divide-y divide-slate-100 text-sm">
                <thead>
                  <tr class="bg-slate-50/75 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                    <th scope="col" class="px-5 py-3.5">No. Tagihan</th>
                    <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Pelanggan</th>
                    <th scope="col" class="hidden px-4 py-3.5 md:table-cell">No. Sewa</th>
                    <th scope="col" class="hidden px-4 py-3.5 lg:table-cell">Tgl Terbit</th>
                    <th scope="col" class="hidden px-4 py-3.5 sm:table-cell">Jatuh Tempo</th>
                    <th scope="col" class="hidden px-4 py-3.5 text-right sm:table-cell">Total</th>
                    <th scope="col" class="hidden px-4 py-3.5 text-right md:table-cell">Dibayar</th>
                    <th scope="col" class="px-4 py-3.5 text-right">Sisa Piutang</th>
                    <th scope="col" class="px-4 py-3.5">Status</th>
                    <th scope="col" class="px-5 py-3.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% invoices.forEach(function (invoice) { %>
                    <tr class="transition hover:bg-slate-50/60">
                      <td class="whitespace-nowrap px-5 py-3.5">
                        <a href="/invoices/<%= invoice.id %>" class="font-semibold text-slate-900 hover:text-brand-600"><%= invoice.invoiceNumber %></a>
                        <div class="sm:hidden mt-0.5">
                          <p class="text-xs font-medium text-slate-800"><%= invoice.rentalRecord.customer.name %></p>
                          <p class="text-[11px] text-slate-400">Tempo: <%= formatDate(invoice.dueDate) %></p>
                        </div>
                      </td>
                      <td class="hidden px-4 py-3.5 sm:table-cell">
                        <a href="/customers/<%= invoice.rentalRecord.customer.id %>" class="block font-medium text-slate-900 hover:text-brand-600"><%= invoice.rentalRecord.customer.name %></a>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-500 md:table-cell">
                        <a href="/rentals/<%= invoice.rentalRecord.id %>" class="hover:text-brand-600"><%= invoice.rentalRecord.rentalNumber %></a>
                      </td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-500 lg:table-cell"><%= formatDate(invoice.issueDate) %></td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-xs text-slate-600 sm:table-cell"><%= formatDate(invoice.dueDate) %></td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-right font-medium tabular-nums text-slate-800 sm:table-cell"><%= formatRupiah(invoice.totalAmount) %></td>
                      <td class="hidden whitespace-nowrap px-4 py-3.5 text-right font-medium tabular-nums text-emerald-700 md:table-cell"><%= formatRupiah(invoice.summary.totalPaid) %></td>
                      <td class="whitespace-nowrap px-4 py-3.5 text-right font-semibold tabular-nums <%= invoice.summary.outstanding > 0 ? 'text-amber-700' : 'text-emerald-700' %>"><%= formatRupiah(invoice.summary.outstanding) %></td>
                      <td class="px-4 py-3.5 whitespace-nowrap">
                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= invoiceStatusClasses[invoice.summary.status] %>">
                          <%= invoiceStatusLabels[invoice.summary.status] %>
                        </span>
                      </td>
                      <td class="px-5 py-3.5 text-right whitespace-nowrap">
                        <a href="/invoices/<%= invoice.id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700">
                          Detail
                          <%- include('../partials/icon', { iconName: 'chevronRight', iconClass: 'h-3.5 w-3.5' }) %>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <%- include('../partials/pagination', { pagination: pagination, path: '/invoices', query: listQuery }) %>
          <% } %>
        </div>
      </div>
    </main>

    <%- include('../partials/foot') %>
  </div>
</body>
</html>
