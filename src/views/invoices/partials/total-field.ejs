<%
  const fieldError = typeof errors !== 'undefined' && errors ? errors.totalAmount : undefined;
  const fieldValue = typeof value !== 'undefined' ? value : '';
  const isOob = typeof oob !== 'undefined' && oob;
%>
<div id="totalAmountField" <%- isOob ? 'hx-swap-oob="true"' : '' %>>
  <label for="totalAmount" class="block text-xs font-semibold text-slate-700">
    Total Nilai Tagihan (Rupiah) <span class="text-rose-500">*</span>
  </label>
  <div class="relative mt-1.5">
    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-sm font-semibold text-slate-400">Rp</span>
    <input
      id="totalAmount"
      name="totalAmount"
      type="text"
      inputmode="numeric"
      required
      value="<%= fieldValue %>"
      aria-invalid="<%= fieldError ? 'true' : 'false' %>"
      <%- fieldError ? 'aria-describedby="total-amount-error"' : 'aria-describedby="total-amount-hint"' %>
      class="block w-full rounded-xl border bg-white py-2.5 pl-11 pr-3.5 text-sm text-slate-900 shadow-2xs transition placeholder:text-slate-400 focus:outline-hidden focus:ring-2 tabular-nums <%= fieldError ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
      placeholder="1500000"
    />
  </div>
  <% if (fieldError) { %>
    <p id="total-amount-error" class="mt-1.5 text-xs font-medium text-rose-600"><%= fieldError %></p>
  <% } else { %>
    <p id="total-amount-hint" class="mt-1.5 text-xs text-slate-400">
      Nilai tersimpan sebagai snapshot tetap. Perubahan harga sewa di masa depan tidak mempengaruhi tagihan ini.
    </p>
  <% } %>
</div>
