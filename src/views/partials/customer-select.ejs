<%
  const hasOob = typeof oob !== 'undefined' && oob;
  const hasError = typeof error !== 'undefined' && Boolean(error);
%>
<select
  id="customerId"
  name="customerId"
  <%- hasOob ? 'hx-swap-oob="true"' : '' %>
  <%- hasError ? 'aria-invalid="true" aria-describedby="customer-error"' : '' %>
  class="mt-1.5 block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs transition focus:outline-hidden focus:ring-2 <%= hasError ? 'border-rose-300 focus:border-rose-500 focus:ring-rose-500/20' : 'border-slate-200 focus:border-brand-500 focus:ring-brand-500/20' %>"
>
  <option value="">Pilih pelanggan yang terdaftar</option>
  <% customers.forEach(function (customer) { %>
    <option value="<%= customer.id %>" <%= selectedId === customer.id ? 'selected' : '' %>>
      <%= customer.name %> (<%= customer.whatsappNumber %>)
    </option>
  <% }); %>
</select>
