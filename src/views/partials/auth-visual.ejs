<section class="relative hidden overflow-hidden bg-slate-900 border-r border-slate-800 px-10 py-12 text-white lg:flex lg:flex-col lg:justify-between">
  <!-- Brand Top Section -->
  <div>
    <div class="flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-600 text-white shadow-xs">
        <%- include('icon', { iconName: 'bell', iconClass: 'h-5 w-5' }) %>
      </span>
      <div>
        <p class="text-base font-bold tracking-tight text-white"><%= locals.appName %></p>
        <p class="text-xs font-medium text-slate-400">Sistem Manajemen Rental &amp; Piutang</p>
      </div>
    </div>

    <!-- Editorial Value Pitch -->
    <div class="mt-12 max-w-lg">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-500/30 bg-brand-950/60 px-3 py-1 text-xs font-semibold text-brand-300">
        <%- include('icon', { iconName: 'shield', iconClass: 'h-3.5 w-3.5 text-brand-400' }) %>
        Platform Khusus Pemilik Rental Indonesia
      </span>
      <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-white"><%= heading %></h1>
      <p class="mt-3 text-sm leading-relaxed text-slate-300"><%= description %></p>
    </div>

    <!-- Realistic Operational Preview Widget -->
    <div class="mt-8 rounded-2xl border border-slate-700/80 bg-slate-800/80 p-5 shadow-lg backdrop-blur-xs">
      <div class="flex items-center justify-between border-b border-slate-700/60 pb-3">
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
          <span class="text-xs font-bold text-slate-200">Antrean Pengingat Hari Ini</span>
        </div>
        <span class="rounded-full bg-slate-700 px-2 py-0.5 text-[10px] font-semibold text-slate-300">Jatuh Tempo H-1</span>
      </div>

      <div class="mt-3 flex items-center justify-between">
        <div>
          <p class="text-sm font-bold text-white">Budi Santoso</p>
          <p class="text-xs text-slate-400">Rental Kamera Sony A7 IV · INV/2026/0014</p>
        </div>
        <div class="text-right">
          <p class="text-sm font-bold text-amber-400">Rp750.000</p>
          <p class="text-[10px] text-slate-400">Sisa Tagihan</p>
        </div>
      </div>

      <div class="mt-4 flex items-center justify-between rounded-xl bg-slate-900/80 px-3.5 py-2.5">
        <span class="text-xs text-slate-300">Template WhatsApp siap kirim</span>
        <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-2.5 py-1 text-xs font-semibold text-white">
          <%- include('icon', { iconName: 'whatsapp', iconClass: 'h-3.5 w-3.5' }) %>
          Buka WhatsApp
        </span>
      </div>
    </div>

    <!-- Key Functional Pillars -->
    <ul class="mt-8 space-y-3.5 text-xs text-slate-300">
      <li class="flex items-start gap-3">
        <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-emerald-500/20 text-emerald-400">
          <%- include('icon', { iconName: 'check', iconClass: 'h-3.5 w-3.5' }) %>
        </span>
        <span><strong class="font-semibold text-white">Isolasi Data Penyewa Mandiri</strong> — Setiap usaha memiliki basis data transaksi terpisah dan terlindungi.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-emerald-500/20 text-emerald-400">
          <%- include('icon', { iconName: 'check', iconClass: 'h-3.5 w-3.5' }) %>
        </span>
        <span><strong class="font-semibold text-white">Pengingat Berjenjang Otomatis</strong> — Terjadwal rapi pada H-3, H-1, Hari H, dan H+1 tanpa risiko lupa.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-emerald-500/20 text-emerald-400">
          <%- include('icon', { iconName: 'check', iconClass: 'h-3.5 w-3.5' }) %>
        </span>
        <span><strong class="font-semibold text-white">Integrasi WhatsApp Satu Klik</strong> — Pesan tagihan ramah tersusun rapi langsung ke aplikasi WhatsApp Anda.</span>
      </li>
    </ul>
  </div>

  <!-- Bottom Proof Bar -->
  <div class="border-t border-slate-800/80 pt-6 text-xs text-slate-400">
    <p>Dirancang untuk kepraktisan operasional pemilik rental mobil, motor, kamera, alat pesta, dan perlengkapan proyek di Indonesia.</p>
  </div>
</section>
