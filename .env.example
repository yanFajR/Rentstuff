# ---------------------------------------------------------------------------
# Rental Reminder - contoh konfigurasi environment
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jangan pernah commit file .env ke repository.
# ---------------------------------------------------------------------------

# Runtime aplikasi
NODE_ENV=development
PORT=3000
APP_NAME="Rental Reminder"
APP_URL=http://localhost:3000

# Zona waktu tampilan & jadwal pengingat bisnis
APP_TIMEZONE=Asia/Jakarta

# Database development (SQLite)
# Path relatif dihitung dari prisma/schema.prisma sehingga menghasilkan prisma/dev.db
DATABASE_URL="file:./dev.db"

# Session server-side
# WAJIB: gunakan string acak minimal 32 karakter.
# Contoh membuat secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
SESSION_NAME=rental_reminder.sid
SESSION_TTL_HOURS=8
SESSION_CLEANUP_INTERVAL_MS=3600000
# Aktifkan hanya jika aplikasi diakses melalui HTTPS.
# Default mengikuti NODE_ENV=production jika tidak diisi.
SESSION_COOKIE_SECURE=false

# Rate limiting
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT=10
AUTH_REGISTER_RATE_WINDOW_MS=3600000
REPORT_EXPORT_RATE_LIMIT=30
REPORT_EXPORT_RATE_WINDOW_MS=900000
MUTATION_RATE_LIMIT=300
MUTATION_RATE_WINDOW_MS=300000

# SQLite production hardening
# WAL disarankan untuk satu instance dengan filesystem lokal.
SQLITE_JOURNAL_MODE=WAL
SQLITE_BUSY_TIMEOUT_MS=5000

# Backup (dipakai scripts/backup-sqlite.mjs; bukan dibaca aplikasi web)
# BACKUP_DIR=/var/backups/rental-reminder
# BACKUP_KIND=daily
# BACKUP_DAILY_KEEP=7
# BACKUP_WEEKLY_KEEP=4
# BACKUP_MONTHLY_KEEP=3

# Catatan production:
# - Gunakan APP_URL=https://domain-anda dan SESSION_COOKIE_SECURE=true.
# - Arahkan DATABASE_URL ke path absolut persistent, misalnya
#   DATABASE_URL="file:/var/lib/rental-reminder/rental.db".
# - Jangan menaruh database/backup di dalam public/ atau folder build.
